.organize-page { padding: 32rpx 28rpx 48rpx; color: #24332e; }
.organize-header { padding: 4rpx 8rpx 28rpx; }
.organize-header-line { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.organize-eyebrow { color: #7c8981; font-size: 20rpx; letter-spacing: 1rpx; }
.organize-status { flex-shrink: 0; padding: 5rpx 16rpx; background: #ede9dc; color: #8a774b; border-radius: 30rpx; font-size: 20rpx; }
.organize-status-done { background: #dfede7; color: #1f6f66; }
.organize-title { display: block; margin-top: 17rpx; font-size: 44rpx; font-weight: 650; letter-spacing: -1rpx; line-height: 1.4; }
.organize-subtitle { display: block; margin-top: 8rpx; color: #7a8780; font-size: 25rpx; }
.organize-path { display: flex; gap: 18rpx; align-items: center; margin-top: 24rpx; color: #859188; font-size: 22rpx; }
.organize-path-active { color: #1f6f66; font-weight: 600; }
.organize-path-arrow { color: #b1bcb2; font-size: 28rpx; }
.organize-card { background: #fff; padding: 28rpx; margin-bottom: 20rpx; border-radius: 28rpx; box-shadow: 0 3rpx 12rpx #23433303; }
.organize-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.organize-section-name { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.organize-step { color: #90a197; font-size: 19rpx; font-weight: 500; letter-spacing: 1rpx; }
.organize-heading { font-size: 29rpx; line-height: 1.5; font-weight: 650; }
.organize-caption { font-size: 20rpx; color: #8a968e; }
.organize-optional { color: #8b978e; font-size: 20rpx; padding: 4rpx 12rpx; background: #f2f5f0; border-radius: 8rpx; }
.organize-section-note { display: block; font-size: 23rpx; line-height: 1.8; color: #7f8a83; margin-top: 12rpx; }
.organize-video-picker { margin-top: 20rpx; padding: 15rpx 18rpx; background: #f4f7f3; border-radius: 12rpx; }
.organize-video-picker-line { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.organize-video-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 23rpx; }
.organize-video { display: block; width: 100%; height: 340rpx; margin-top: 22rpx; border-radius: 18rpx; overflow: hidden; background: #253d34; }
.organize-video-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 22rpx; min-height: 236rpx; padding: 24rpx 10rpx; background: #f0f5ef; border: 1rpx dashed #c4d6c8; border-radius: 18rpx; text-align: center; }
.organize-video-icon { position: relative; width: 66rpx; height: 48rpx; border: 2rpx solid #8eafa0; border-radius: 13rpx; margin-bottom: 18rpx; }
.organize-video-icon::after { content: ''; position: absolute; top: 12rpx; right: -16rpx; width: 14rpx; height: 24rpx; border: 2rpx solid #8eafa0; border-left: 0; border-radius: 0 5rpx 5rpx 0; }
.organize-video-icon view { width: 10rpx; height: 10rpx; border-radius: 50%; background: #a7c0b1; margin: 10rpx; }
.organize-empty-title { color: #527563; font-size: 26rpx; font-weight: 500; }
.organize-empty-subtitle { color: #8b9c8e; font-size: 20rpx; line-height: 1.7; margin-top: 8rpx; }
.organize-video-footer { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 20rpx; }
.organize-page .organize-button { display: block; width: 100%; padding: 0 22rpx; min-height: 84rpx; line-height: 84rpx; margin: 22rpx 0 0; border: 0; border-radius: 18rpx; background: #1f6f66; color: #fff; font-size: 26rpx; font-weight: 550; text-align: center; }
.organize-page .organize-button::after { border: 0; }
.organize-page .organize-button[disabled] { opacity: 1; background: #e4ece6; color: #96a69b; }
.organize-page .organize-button-small { width: auto; min-height: 62rpx; line-height: 62rpx; font-size: 22rpx; margin: 0; border-radius: 12rpx; flex-shrink: 0; padding: 0 18rpx; }
.organize-page .organize-button-soft { color: #1f6f66; background: #eaf2eb; }
.organize-button-plus { font-size: 27rpx; margin-left: 8rpx; font-weight: 400; }
.organize-document-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 24rpx; }
.organize-upload-tile { border: 1rpx solid #e2e9e0; background: #fbfcf9; border-radius: 18rpx; padding: 24rpx 22rpx 22rpx; }
.organize-upload-top { display: flex; align-items: flex-start; justify-content: space-between; }
.organize-upload-plus { color: #8eaa99; font-size: 31rpx; line-height: 1; }
.organize-file-icon { display: flex; flex-direction: column; justify-content: center; align-items: center; width: 47rpx; height: 57rpx; border: 2rpx solid #89a897; border-radius: 7rpx; color: #789b86; }
.organize-file-medical text { font-size: 30rpx; line-height: 31rpx; }
.organize-file-medical view { height: 2rpx; width: 22rpx; background: #a2b8aa; margin-top: 2rpx; }
.organize-file-training { gap: 7rpx; }
.organize-file-training view { height: 2rpx; width: 24rpx; background: #8eac9a; }
.organize-file-training view:last-child { width: 15rpx; align-self: flex-start; margin-left: 10rpx; }
.organize-tile-title { display: block; font-size: 27rpx; font-weight: 550; margin-top: 21rpx; }
.organize-tile-note { display: block; font-size: 20rpx; line-height: 1.7; color: #88958b; margin-top: 6rpx; }
.organize-documents { margin-top: 20rpx; }
.organize-document { padding: 22rpx 0; border-bottom: 1rpx solid #edf0e9; }
.organize-document-main { display: flex; gap: 18rpx; }
.organize-document-thumb { flex-shrink: 0; width: 86rpx; height: 110rpx; border-radius: 9rpx; background: #edf2e9; border: 1rpx solid #e2e8de; object-fit: cover; }
.organize-document-info { flex: 1; min-width: 0; }
.organize-document-title-line { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.organize-document-title { font-size: 25rpx; font-weight: 550; }
.organize-document-status { font-size: 20rpx; color: #618977; }
.organize-document-excerpt { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 21rpx; color: #8a958b; line-height: 1.6; margin-top: 8rpx; word-break: break-all; }
.organize-document-actions { display: flex; flex-wrap: wrap; gap: 22rpx; margin-top: 10rpx; }
.organize-link { color: #367c68; font-size: 21rpx; white-space: nowrap; }
.organize-footnote { display: flex; align-items: flex-start; justify-content: center; gap: 9rpx; margin-top: 17rpx; color: #8d978e; font-size: 20rpx; line-height: 1.7; }
.organize-footnote-mark { display: flex; align-items: center; justify-content: center; width: 23rpx; height: 23rpx; border: 1rpx solid #a3b19f; border-radius: 50%; font-size: 16rpx; font-family: Georgia, serif; line-height: 1; margin-top: 4rpx; flex-shrink: 0; }
.organize-transcript { padding: 22rpx 18rpx; margin-top: 20rpx; background: #f5f7f2; border-radius: 14rpx; }
.organize-transcript-title-line { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.organize-transcript-buttons { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 18rpx; }
.organize-page .organize-input { display: block; box-sizing: border-box; width: 100%; min-height: 82rpx; margin: 12rpx 0 0; padding: 20rpx; border: 1rpx solid #e6ebe2; border-radius: 13rpx; background: #f8faf6; font-size: 25rpx; line-height: 1.65; color: #2c3b31; }
.organize-page .organize-transcript-input { height: 280rpx; background: #fff; font-size: 23rpx; }
.organize-context { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #edf0e9; }
.organize-context-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.organize-context-text { display: block; white-space: pre-wrap; color: #78867b; font-size: 23rpx; line-height: 1.85; margin-top: 14rpx; }
.organize-count { color: #738c78; background: #f0f5ec; border-radius: 20rpx; font-size: 20rpx; padding: 4rpx 13rpx; }
.organize-candidate { margin-top: 20rpx; border: 1rpx solid #dbe7dc; border-radius: 16rpx; padding: 21rpx; background: #f8fbf6; }
.organize-candidate-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.organize-candidate-name { flex: 1; min-width: 0; font-size: 27rpx; font-weight: 550; }
.organize-candidate-link { flex-shrink: 0; font-size: 20rpx; color: #2f7965; }
.organize-candidate-dose { display: block; font-size: 23rpx; color: #4f715d; margin-top: 10rpx; }
.organize-candidate-source { display: block; font-size: 21rpx; color: #8a978b; margin-top: 14rpx; padding-top: 13rpx; border-top: 1rpx solid #e6ece2; line-height: 1.75; }
.organize-candidate-match { display: inline-block; color: #8d7956; background: #f3edde; padding: 3rpx 10rpx; border-radius: 6rpx; font-size: 19rpx; margin-top: 12rpx; }
.organize-no-actions { padding: 26rpx 18rpx; text-align: center; background: #f5f7f2; border-radius: 15rpx; margin-top: 20rpx; }
.organize-manual-heading { display: flex; justify-content: space-between; gap: 18rpx; align-items: center; }
.organize-source { padding: 19rpx 21rpx; border-radius: 12rpx; background: #f2f6ed; margin-top: 24rpx; }
.organize-source-label { display: block; color: #719278; font-size: 20rpx; margin-bottom: 6rpx; }
.organize-source-text { display: block; color: #677965; font-size: 23rpx; line-height: 1.8; }
.organize-label { display: block; font-size: 24rpx; font-weight: 500; color: #536851; margin-top: 27rpx; }
.organize-label-optional { color: #9ca69a; font-size: 20rpx; font-weight: 400; margin-left: 12rpx; }
.organize-page .organize-notes { height: 156rpx; }
.organize-modes { display: flex; gap: 10rpx; margin-top: 14rpx; }
.organize-modes text { flex: 1; min-width: 0; padding: 15rpx 4rpx; border: 1rpx solid #e4eade; border-radius: 11rpx; background: #f7f9f4; color: #82907c; font-size: 23rpx; text-align: center; }
.organize-modes .organize-mode-selected { color: #1f6f66; background: #e7f1e8; border-color: #a0c2aa; font-weight: 550; }
.organize-dose-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20rpx; }
.organize-input-unit { position: relative; }
.organize-input-unit .organize-input { padding-right: 60rpx; }
.organize-input-unit > text { position: absolute; right: 20rpx; top: 23rpx; font-size: 23rpx; color: #9aa693; }
.organize-frequency { margin-top: 23rpx; padding: 19rpx 21rpx; background: #f6f8f2; border-radius: 12rpx; font-size: 23rpx; color: #6b7e62; }
.organize-frequency .organize-caption { display: block; margin-top: 8rpx; }
.organize-warnings { margin-top: 20rpx; padding: 18rpx; background: #faf2e6; color: #94764c; border-radius: 11rpx; font-size: 22rpx; line-height: 1.75; }
.organize-warnings text { display: block; }
.organize-confirm { display: flex; align-items: flex-start; gap: 15rpx; margin-top: 32rpx; padding-top: 26rpx; border-top: 1rpx solid #edf0e7; color: #596f55; font-size: 23rpx; line-height: 1.7; }
.organize-checkbox { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 4rpx; border: 2rpx solid #b9c9b6; border-radius: 8rpx; font-size: 22rpx; line-height: 1; }
.organize-checkbox-checked { background: #1f6f66; border-color: #1f6f66; color: #fff; }
.organize-confirm-note { display: block; margin: 12rpx 0 0 49rpx; color: #97a08e; font-size: 20rpx; }
.organize-save-area { padding: 0 6rpx; }
.organize-page .organize-save-button { margin-top: 26rpx; min-height: 92rpx; line-height: 92rpx; font-size: 28rpx; }
.organize-page .organize-draft-button { margin-top: 10rpx; background: transparent; color: #5d7b60; font-size: 25rpx; font-weight: 400; }
.organize-bottom-note { display: block; text-align: center; color: #a1a99a; font-size: 20rpx; margin-top: 8rpx; }
.organize-tabs { display: flex; gap: 10rpx; margin: 0 0 24rpx; padding: 7rpx; background: #e7ede2; border-radius: 17rpx; }
.organize-tabs text { flex: 1; font-size: 24rpx; text-align: center; padding: 12rpx 9rpx; color: #8a9981; border-radius: 12rpx; }
.organize-tabs text:first-child { flex: 1.6; }
.organize-tabs .organize-tab-selected { background: #fff; color: #1f6f66; box-shadow: 0 2rpx 7rpx #223a2509; font-weight: 550; }
.organize-error { margin-bottom: 20rpx; padding: 21rpx 24rpx; background: #f8ece5; border-radius: 15rpx; font-size: 23rpx; line-height: 1.75; color: #a86c4f; }
.organize-text-error { color: #a86c4f; }
.organize-practice-dose { display: block; font-size: 34rpx; font-weight: 550; color: #1f6f66; margin: 30rpx 0; }
.organize-history-actual { display: block; margin-top: 14rpx; color: #52754f; font-size: 25rpx; }
.organize-history-empty { color: #8c9a82; font-size: 24rpx; text-align: center; padding: 50rpx 20rpx; }
