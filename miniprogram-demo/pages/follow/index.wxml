<view class="follow-page">
  <view class="follow-nav" style="padding-top: {{navTop}}px">
    <view class="follow-nav-bar" style="height: {{navHeight}}px">
      <button class="follow-exit" bindtap="requestExit" aria-label="退出训练"><view class="follow-back-icon"></view><text>退出</text></button>
      <text class="follow-nav-title">跟练</text>
    </view>
  </view>
  <view class="follow-content">
    <view wx:if="{{error}}" class="flow-error">{{error}}</view>
    <view wx:if="{{selected && !celebrating}}" class="follow-training-card">
      <text wx:if="{{selected.groupName}}" class="follow-group-label">{{selected.groupName}}</text>
      <text class="follow-exercise-name">{{selected.name}}</text>
      <text wx:if="{{selected.totalOnly}}" class="follow-dose">单次练习 · {{selected.dose}}</text>
      <text wx:else class="follow-dose">第 {{index + 1}} 组 / {{selected.sets}} 组 · {{selected.dose}}</text>
      <view wx:if="{{selected.groups.length}}" class="follow-groups">
        <button wx:for="{{selected.groups}}" wx:for-index="groupIndex" wx:key="*this" data-index="{{item}}" bindtap="selectGroup" class="follow-group {{index === item ? 'follow-group-active' : ''}}" aria-pressed="{{index === item}}">第 {{item + 1}} 组</button>
      </view>
      <text wx:if="{{selected.notes}}" class="follow-notes">{{selected.notes}}</text>
      <video wx:if="{{selected.video}}" src="{{selected.video}}" controls class="flow-video" />
      <view class="follow-ring"><text class="follow-number">{{value}}</text><text class="follow-unit">{{selected.unit}}</text></view>
      <text class="follow-status">进度 {{progress}}% · {{finished ? '本组节奏结束' : running ? '跟练中' : hasStarted ? '已暂停' : '未开始'}}</text>
      <view wx:if="{{selected.mode !== 'timer'}}" class="follow-cadence"><text>每次节奏</text><input type="number" value="{{seconds}}" bindinput="inputSeconds" aria-label="每次节奏秒数" /><text>秒</text></view>
      <button class="follow-primary follow-playback" bindtap="togglePlayback">{{running ? '暂停' : hasStarted && !finished ? '继续' : '开始'}}</button>
      <block wx:if="{{trainingStarted}}">
        <button class="follow-voice" bindtap="toggleVoice" aria-pressed="{{voiceOn}}">数字语音播报：{{voiceOn ? '开' : '关'}}</button>
        <button class="follow-primary follow-complete" bindtap="completeExercise" loading="{{saving}}" disabled="{{saving}}">完成</button>
      </block>
    </view>
    <view wx:elif="{{celebrating}}" class="follow-completion" aria-role="alert">
      <view class="completion-art">
        <view wx:for="{{confetti}}" wx:key="angle" class="completion-confetti" style="--x: {{item.x}}rpx; --y: {{item.y}}rpx; --angle: {{item.angle}}deg; background: {{item.color}}"></view>
        <view class="completion-halo"></view>
        <image class="completion-mascot" src="/assets/brand/xiaozhi-mascot-v1.png" mode="aspectFit" aria-label="小枝为你庆祝"/>
        <view class="completion-mark"><view class="completion-check"></view></view>
      </view>
      <text class="completion-title">恭喜你完成了这项训练</text>
      <text class="completion-name">{{selected.name}}</text>
      <button class="follow-primary completion-return" bindtap="returnToTraining">返回训练</button>
    </view>
  </view>
</view>
