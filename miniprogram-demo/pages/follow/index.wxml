<view class="flow-page">
  <text class="flow-title">按个人要求跟练</text>
  <view wx:if="{{error}}" class="flow-error">{{error}}</view>
  <view wx:if="{{selected}}" class="follow-action-progress">
    <text class="follow-position">本次计划 · 第 {{actionNumber}} / {{actionTotal}} 项</text>
    <text class="follow-progress-count">已跟练 {{completedActions}} 项</text>
  </view>
  <view wx:if="{{selected}}" class="flow-card">
    <text wx:if="{{selected.groupName}}" class="follow-group-label">{{selected.groupName}}</text>
    <text class="flow-heading {{currentDone ? 'follow-action-done' : ''}}">{{selected.name}}</text>
    <text wx:if="{{selected.totalOnly}}" class="flow-muted">单次练习 · {{selected.dose}}</text>
    <text wx:else class="flow-muted">第 {{index + 1}} 组 / {{selected.sets}} 组 · {{selected.dose}}</text>
    <view wx:if="{{selected.groups.length}}" class="flow-tabs">
      <text wx:for="{{selected.groups}}" wx:key="*this" data-index="{{item}}" bindtap="selectGroup" class="{{index === item ? 'flow-selected' : ''}}">第 {{item + 1}} 组</text>
    </view>
    <text class="flow-body">{{selected.notes}}</text>
    <video wx:if="{{selected.video}}" src="{{selected.video}}" controls class="flow-video" />
    <view class="flow-ring">{{value}}<text>{{selected.unit}}</text></view>
    <text class="flow-muted">进度 {{progress}}% · {{finished ? '节奏已结束' : running ? '跟练中' : '等待 / 已暂停'}}</text>
    <input wx:if="{{selected.mode !== 'timer'}}" class="flow-input" type="number" value="{{seconds}}" bindinput="inputSeconds" placeholder="每次节奏秒数，以现场指导为准" />
    <button class="flow-button" bindtap="{{running ? 'pause' : 'start'}}">{{running ? '暂停节奏' : '开始 / 继续'}}</button>
    <button class="flow-button flow-secondary" bindtap="toggleVoice">数字语音播报：{{voiceOn ? '开' : '关'}}</button>
    <text class="flow-label">{{selected.totalOnly ? '实际完成量' : '本组实际完成量'}} / {{selected.unit}}</text>
    <input class="flow-input" type="number" value="{{actual}}" bindinput="inputActual" placeholder="请按真实完成量填写" />
    <button class="flow-button" bindtap="confirm">保存{{selected.totalOnly ? '实际完成量' : '本组实际完成量'}}</button>
    <button class="flow-button flow-secondary" bindtap="manual">查看 / 修改全部组记录</button>
    <button class="flow-button flow-secondary" bindtap="next">下一个动作</button>
    <text class="flow-small">跟练结束会划线标记，实际完成量仍需确认；跟练与手动修改共用一份记录。</text>
  </view>
  <view wx:if="{{actionGroups.length}}" class="follow-checklist">
    <view class="flow-row follow-checklist-heading">
      <text class="flow-heading">当日训练清单</text>
      <text class="follow-total">{{actionTotal}} 项</text>
    </view>
    <text class="flow-small">按组别查看动作，点击可切换跟练</text>
    <view wx:for="{{actionGroups}}" wx:key="name" wx:for-item="group" class="follow-checklist-group">
      <text class="follow-group-name">{{group.name}}</text>
      <view wx:for="{{group.rows}}" wx:key="cardId" wx:for-item="action" class="follow-checklist-action {{action.current ? 'follow-current-action' : ''}}" data-card-id="{{action.cardId}}" bindtap="selectAction">
        <view class="follow-action-marker {{action.done ? 'follow-action-marker-done' : ''}}">{{action.done ? '✓' : action.number}}</view>
        <view class="follow-action-content">
          <text class="follow-action-name {{action.done ? 'follow-action-done' : ''}}">{{action.name}}</text>
          <text class="follow-action-dose {{action.done ? 'follow-action-done' : ''}}">{{action.dose}}</text>
          <view wx:if="{{action.sets.length}}" class="follow-set-list">
            <text wx:for="{{action.sets}}" wx:key="number" wx:for-item="set" class="follow-set {{set.done ? 'follow-set-done' : ''}} {{set.current ? 'follow-set-current' : ''}}">{{set.label}}{{set.done ? ' ✓' : ''}}</text>
          </view>
          <text class="follow-action-state">{{action.stateText}}</text>
        </view>
        <text wx:if="{{action.current}}" class="follow-current-label">当前</text>
      </view>
    </view>
  </view>
</view>
