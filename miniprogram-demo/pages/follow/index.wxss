.follow-action-progress{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:24rpx 0 12rpx;padding:20rpx 24rpx;background:#e3efea;border-radius:20rpx;color:#1f6f66}
.follow-position{font-size:28rpx;font-weight:700}.follow-progress-count{font-size:23rpx;white-space:nowrap}.follow-group-label{display:block;margin-bottom:12rpx;font-size:23rpx;font-weight:600;color:#1f6f66}
.follow-checklist{margin-top:36rpx}.follow-checklist-heading{margin-bottom:8rpx}.follow-total{color:#718078;font-size:24rpx}.follow-checklist-group{margin-top:24rpx}.follow-group-name{display:block;font-size:27rpx;font-weight:700;margin:0 0 14rpx 4rpx}
.follow-checklist-action{display:flex;align-items:flex-start;gap:18rpx;padding:24rpx 20rpx;margin:12rpx 0;background:#fff;border:2rpx solid transparent;border-radius:22rpx}.follow-current-action{border-color:#76aaa0;background:#f3faf7}.follow-action-marker{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:40rpx;height:40rpx;border:2rpx solid #b9c8c0;border-radius:50%;font-size:22rpx;font-weight:600;color:#718078;box-sizing:border-box}.follow-action-marker-done{background:#1f6f66;border-color:#1f6f66;color:#fff}.follow-action-content{flex:1;min-width:0}.follow-action-name{display:block;font-size:28rpx;line-height:1.5;font-weight:600;word-break:break-all}.follow-action-dose{display:block;font-size:24rpx;color:#718078;margin-top:5rpx}.follow-action-done{text-decoration:line-through;color:#82918a}.follow-current-label{font-size:21rpx;font-weight:600;color:#1f6f66;white-space:nowrap;margin-top:5rpx}.follow-action-state{display:block;font-size:22rpx;color:#718078;margin-top:10rpx}
.follow-set-list{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:14rpx}.follow-set{font-size:20rpx;padding:4rpx 10rpx;border:1rpx solid #e0e9e3;border-radius:8rpx;color:#8a9790;background:#f6f8f5}.follow-set-done{color:#1f6f66;background:#e0efea;text-decoration:line-through}.follow-set-current{border-color:#1f6f66}
