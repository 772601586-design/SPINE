.growth-records-page { padding-bottom: calc(38rpx + env(safe-area-inset-bottom)); }
.growth-records-header { padding: 46.15rpx 38.46rpx 0; }
.growth-records-title { display: block; font-size: 50rpx; font-weight: 700; }
.growth-records-description { display: block; font-size: 25rpx; color: #5B6663; margin-top: 7.69rpx; }
.growth-records-history { padding-bottom: 0; }
.growth-records-history .flow-section:first-child { margin-top: 0; }
.calendar-section-heading{margin-bottom:20rpx}
.training-calendar{background:#fff;border:1rpx solid #E8EBDD;border-radius:30rpx;padding:20rpx 22rpx 24rpx}
.calendar-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:20rpx}
.training-calendar .calendar-arrow{flex:0 0 68rpx;width:68rpx;min-width:0;height:68rpx;line-height:62rpx;padding:0;margin:0;border-radius:20rpx;background:#F2F5EC;color:#50724F;font-size:44rpx;font-weight:400}
.calendar-month-picker{flex:1;min-width:0}
.calendar-month-title{display:flex;align-items:center;justify-content:center;gap:14rpx;color:#344D39;font-size:31rpx;font-weight:650;line-height:68rpx}
.calendar-month-caret{font-size:23rpx;color:#8C9B81}
.calendar-weekdays,.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}
.calendar-weekdays{font-size:23rpx;color:#929B88;text-align:center;line-height:50rpx;margin-bottom:8rpx}
.calendar-cell{display:flex;align-items:center;justify-content:center;min-height:84rpx}
.training-calendar .calendar-day{position:relative;display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;width:64rpx;min-width:0;height:64rpx;line-height:1;margin:0;padding:0;border-radius:50%;font-size:27rpx;font-weight:500;background:transparent;color:#65775E;overflow:visible}
.training-calendar .calendar-day-completed{background:#4F7D57;color:#fff}
.training-calendar .calendar-day-incomplete{background:#F4D8AA;color:#8B612F}
.training-calendar .calendar-day-selected{box-shadow:0 0 0 3rpx #fff,0 0 0 5rpx #8BA57D}
.calendar-today-dot{position:absolute;bottom:6rpx;width:5rpx;height:5rpx;border-radius:50%;background:#6D9773}
.calendar-day-completed .calendar-today-dot{background:#fff}
.calendar-month-summary{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:22rpx 0 12rpx;margin-top:18rpx;border-top:1rpx solid #EDF0E6;color:#8A947E;font-size:21rpx}
.calendar-completed-count{color:#4F7D57;font-weight:600}.calendar-incomplete-count{color:#B1854E;font-weight:600}
.training-calendar .calendar-today{width:auto;min-width:0;margin:0;padding:8rpx 12rpx;border-radius:16rpx;background:#F1F5EA;color:#627E55;font-size:21rpx;font-weight:500;line-height:1.5}
.calendar-legend{display:flex;justify-content:center;gap:24rpx;flex-wrap:wrap;color:#8A947E;font-size:21rpx;margin:16rpx 0}
.calendar-legend>view{display:flex;align-items:center;gap:8rpx}
.legend-dot{display:inline-block;width:15rpx;height:15rpx;border-radius:50%;box-sizing:border-box}
.legend-completed{background:#4F7D57}.legend-incomplete{background:#F4D8AA}.legend-empty{background:#fff;border:2rpx solid #D9E1D1}
.calendar-hint{display:block;text-align:center;font-size:21rpx;color:#9AA38F;line-height:1.7}
.calendar-arrow::after,.calendar-day::after,.calendar-today::after{border:0}
