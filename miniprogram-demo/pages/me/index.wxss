.me-profile-header{display:flex;align-items:center;gap:24rpx}
.me-avatar{position:relative;flex:0 0 116rpx;width:116rpx;height:116rpx;border-radius:50%;margin:0;padding:0;background:#3f746b;color:#fff;font-size:43rpx;display:flex;align-items:center;justify-content:center;overflow:hidden}
.me-avatar image{width:100%;height:100%}
.me-avatar-edit{position:absolute;bottom:0;left:0;right:0;background:#264d4680;color:#fff;text-align:center;font-size:18rpx;line-height:30rpx;font-weight:400}
.me-nickname{flex:1;min-width:0;font-size:39rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.me-profile-header .me-personal-info{flex-shrink:0;width:auto;min-width:0;border:1.92rpx solid #c9d4d0;background:transparent;border-radius:40rpx;padding:0 22rpx;margin:0;font-size:25rpx;font-weight:400;color:#3e4b47;line-height:66rpx}
.me-avatar::after,.me-personal-info::after{border:0}
.me-records-card{display:flex;justify-content:space-between;align-items:center;gap:22rpx;padding:28rpx;border-radius:30rpx;background:#fff}
.me-records-title{display:block;font-size:30rpx;font-weight:600}
.me-records-description{display:block;font-size:24rpx;color:#718078;margin-top:9rpx}
.me-records-chevron{font-size:34rpx;color:#8a9590}
.me-brace-setting { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:112rpx; font-size:26.92rpx; color:#1f2a27; }
.me-brace-description { display:block; margin-top:4rpx; color:#5b6663; font-size:23.08rpx; }
.me-brace-setting .me-brace-switch { position:relative; flex:0 0 92.31rpx; width:92.31rpx; height:53.85rpx; padding:0; margin:0; border:0; border-radius:54rpx; background:#c9d4d0; transition:background-color 180ms ease; }
.me-brace-switch::after { border:0; }
.me-brace-switch-thumb { position:absolute; top:7.69rpx; left:7.69rpx; width:38.46rpx; height:38.46rpx; border-radius:50%; background:#fff; transition:transform 180ms ease; }
.me-brace-setting .me-brace-switch-on { background:#1f6f66; }
.me-brace-switch-on .me-brace-switch-thumb { transform:translateX(38.46rpx); }
.me-reward-label{display:flex;align-items:center;gap:14rpx}
.me-reward-label image{width:38rpx;height:38rpx}
