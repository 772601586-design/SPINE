page{background:#f3f5f2;color:#1f2a27}
.personal-info-page{padding:36rpx 38rpx calc(50rpx + env(safe-area-inset-bottom));min-height:100vh;box-sizing:border-box}
.info-card{padding:0 28rpx;border-radius:30rpx;background:#fff;overflow:hidden}
.avatar-row{display:flex;align-items:center;gap:22rpx;padding:30rpx 0}
.avatar-button{flex:0 0 116rpx;width:116rpx;height:116rpx;border-radius:50%;padding:0;margin:0;background:#3f746b;color:#fff;font-size:44rpx;display:flex;align-items:center;justify-content:center;overflow:hidden}
.avatar-button image{width:100%;height:100%}
.avatar-copy{display:flex;flex-direction:column;gap:8rpx;flex:1;min-width:0}
.info-label{font-size:29rpx;white-space:nowrap}
.info-hint{font-size:23rpx;color:#8a9590}
.avatar-row .change-avatar{flex:0 0 auto;width:auto;min-width:0;font-size:25rpx;background:transparent;color:#1f6f66;margin:0;padding:8rpx 0 8rpx 10rpx;line-height:2}
.info-card .remove-avatar{width:100%;margin:-6rpx 0 20rpx;padding:0;text-align:left;line-height:2;color:#7c8781;background:transparent;font-size:23rpx}
.info-row{display:flex;align-items:center;justify-content:space-between;gap:28rpx;min-height:108rpx;border-top:1rpx solid #eef2f0}
.info-value{font-size:27rpx;color:#5b6663;text-align:right}
.nickname-input{flex:1;min-width:0;text-align:right;font-size:29rpx;height:80rpx;color:#1f2a27}
.chevron{margin-left:20rpx;color:#8a9590}
.section-label{display:block;font-size:25rpx;color:#6b7872;margin:38rpx 12rpx 18rpx}
.login-card .info-row:first-child{border-top:0}
.info-note{display:block;color:#8a9590;font-size:23rpx;margin:22rpx 12rpx 38rpx}
.info-error{font-size:25rpx;color:#ad5555;margin:20rpx 8rpx}
.personal-info-page .save-info{width:100%;margin:0;min-height:92rpx;border-radius:24rpx;color:#fff;background:#1f6f66;font-size:30rpx;font-weight:600;line-height:92rpx}
button::after{border:0}
.save-info[disabled]{background:#b5c9c3;color:#fff}
