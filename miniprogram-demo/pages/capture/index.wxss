.capture-source-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.capture-source-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(20, 35, 29, 0.42);
}

.capture-source-panel {
  position: relative;
  width: 620rpx;
  max-width: calc(100% - 64rpx);
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fff;
  max-height: 85vh;
  overflow-y: auto;
}

.capture-source-title {
  display: block;
  margin-bottom: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.capture-source-options {
  display: flex;
  gap: 24rpx;
}

.capture-source-option {
  flex: 1;
  margin: 0;
  padding: 28rpx 10rpx;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  border-radius: 12rpx;
  background: #edf4f0;
  color: #1f6f66;
  font-size: 28rpx;
  line-height: 1.5;
}

.capture-source-option::after,
.capture-source-cancel::after { border: 0; }

.capture-source-icon { font-size: 52rpx; line-height: 1; }

.capture-source-cancel {
  margin: 24rpx 0 0;
  background: #f3f5f2;
  color: #718078;
  font-size: 28rpx;
  border-radius: 10rpx;
}

.capture-details-label { display: block; color: #52665a; font-size: 26rpx; }
.capture-details-notes { height: 160rpx; min-height: 160rpx; }
.capture-taxonomy { display: flex; flex-wrap: wrap; margin: 16rpx 0 24rpx; }
.capture-taxonomy label { width: 50%; padding: 10rpx 0; font-size: 24rpx; box-sizing: border-box; }
.capture-taxonomy checkbox { transform: scale(0.75); }
