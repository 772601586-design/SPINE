<view class="community-page">
 <view wx:if="{{screen === 'home'}}">
  <view class="community-heading">社群<text class="demo-label">本机体验</text></view>
  <view class="search-box" bindtap="search"><text class="search-icon"></text><text>搜索问题与经历</text></view>
  <view class="section-tabs"><view wx:for="{{tabs}}" wx:key="*this" class="section-tab {{tab === item ? 'active' : ''}}" bindtap="pickTab" data-value="{{item}}">{{item}}</view></view>
  <view wx:if="{{tab === '交流'}}" class="feeling-row"><text class="section-title">今天感觉怎么样？</text><text class="teal" bindtap="compose">记心情 ›</text></view>
  <view class="filters {{tab === '知识' ? 'knowledge-filters' : ''}}"><view wx:for="{{tab === '交流' ? filters : categories}}" wx:key="*this" class="chip {{filter === item ? 'chosen' : ''}}" bindtap="pickFilter" data-value="{{item}}">{{item}}</view></view>
  <block wx:if="{{tab === '交流'}}">
   <view wx:for="{{shownPosts}}" wx:key="id" class="post-card">
    <view bindtap="openPost" data-id="{{item.id}}"><view class="author">{{item.name}}<text wx:if="{{item.private}}" class="private-label">仅自己可见</text></view><view class="muted meta">{{item.time}} · 个人分享</view><view class="post-body">{{item.body}}</view><text class="topic"># {{item.topic}}</text></view>
    <view class="post-actions"><text bindtap="hug" data-id="{{item.id}}" class="{{item.hugged ? 'teal' : ''}}">{{item.hugged ? '已抱抱' : '抱抱'}} {{item.hugs}}</text><text class="divider">|</text><text bindtap="openPost" data-id="{{item.id}}">评论 {{item.comments}}</text></view>
   </view>
   <view wx:if="{{!shownPosts.length}}" class="empty">还没有这类分享，来聊聊你的经历吧。</view>
   <view class="publish-fab" bindtap="compose"><text class="plus">＋</text><text>发布</text></view>
  </block>
  <block wx:else><view wx:for="{{shownArticles}}" wx:key="id" class="article-card" bindtap="openArticle" data-id="{{item.id}}"><view class="article-title">{{item.title}}</view><view class="summary">{{item.summary}}</view><view class="muted meta">{{item.category}} · {{item.reads}}阅读</view><text class="chevron">›</text></view><view wx:if="{{!shownArticles.length}}" class="empty">这个分类的内容正在整理中。</view></block>
  <view class="demo-note">示例社群 · 分享与互动仅保存在本机</view>
 </view>
 <view wx:elif="{{screen === 'search'}}">
  <view class="search-header"><text class="back" bindtap="back">‹</text><view class="search-box"><text class="search-icon"></text><input value="{{query}}" placeholder="搜索问题与经历" bindinput="inputSearch"/><text bindtap="clearSearch" aria-label="清空搜索">⊗</text></view></view>
  <view class="section-tabs"><view wx:for="{{searchTabs}}" wx:key="*this" class="section-tab {{searchTab === item ? 'active' : ''}}" bindtap="pickSearchTab" data-value="{{item}}">{{item}}</view></view>
  <block wx:if="{{searchTab !== '经历'}}"><view class="section-title result-heading">相关知识</view><view wx:for="{{shownArticles}}" wx:key="id" class="article-card" bindtap="openArticle" data-id="{{item.id}}"><view class="article-title">{{item.title}}</view><view class="summary">{{item.summary}}</view><view class="muted meta">{{item.category}} · {{item.reads}}阅读</view><text class="chevron">›</text></view><view wx:if="{{!shownArticles.length}}" class="empty">暂时没有相关知识</view></block>
  <block wx:if="{{searchTab !== '知识'}}"><view class="section-title result-heading">大家的经历</view><view wx:for="{{shownPosts}}" wx:key="id" class="article-card" bindtap="openPost" data-id="{{item.id}}"><view class="article-title">{{item.title}}</view><view class="summary">{{item.body}}</view><view class="muted meta">个人分享 · 抱抱 {{item.hugs}} · 评论 {{item.comments}}</view><text class="chevron">›</text></view><view wx:if="{{!shownPosts.length}}" class="empty">暂时没有相关经历</view></block>
  <view class="no-answer"><text class="muted">没找到答案？</text><button class="outline-button" bindtap="compose" data-type="问问题">发布问题</button></view>
 </view>
 <view wx:elif="{{screen === 'compose'}}">
  <view class="page-header"><text class="back" bindtap="back">‹</text><text>发布</text><text class="header-action" bindtap="saveDraft">保存</text></view>
  <view class="section-tabs"><view wx:for="{{composeTabs}}" wx:key="*this" class="section-tab {{composeType === item ? 'active' : ''}}" bindtap="pickType" data-value="{{item}}">{{item}}</view></view>
  <view class="section-title result-heading">{{composeType === '记心情' ? '现在的心情' : composeType === '问问题' ? '想问大家什么？' : '分享你的经历'}}</view>
  <view wx:if="{{composeType === '记心情'}}" class="moods"><view wx:for="{{moods}}" wx:key="*this" class="chip {{mood === item ? 'chosen' : ''}}" bindtap="pickMood" data-value="{{item}}">{{item}}</view></view>
  <view class="editor"><textarea value="{{body}}" maxlength="500" placeholder="把此刻的想法写下来，慢慢说也没关系。" bindinput="inputBody"/><view class="image-row"><view wx:for="{{images}}" wx:key="*this" class="image-wrap"><image src="{{item}}" mode="aspectFill"/><text bindtap="removeImage" data-index="{{index}}">×</text></view><view wx:if="{{images.length < 3}}" class="add-image" bindtap="addImage">＋ 添加图片</view></view><text class="word-count">{{body.length}}/500</text></view>
  <view class="setting-row"><text>话题</text><text class="muted">{{composeType === '记心情' ? mood : composeType}}</text></view>
  <view class="setting-row" bindtap="visibility"><text>谁可以看</text><text class="muted">{{visibility}} ›</text></view>
  <view class="muted compose-note">{{composeType === '记心情' ? '只选心情，也可以保存。' : '分享个人体验，让交流多一份理解。'}}</view><button class="primary-button" bindtap="submit">{{visibility === '仅自己可见' ? '保存' : '发布'}}{{composeType === '记心情' ? '心情' : composeType === '问问题' ? '问题' : '经历'}}</button>
  <view class="demo-note">本机演示，内容不会发布到线上社群</view>
 </view>
 <view wx:elif="{{screen === 'post'}}">
  <view class="page-header"><text class="back" bindtap="back">‹</text><text>详情</text><text></text></view>
  <view class="detail-author author">{{selected.name}}</view><view class="muted meta">个人分享 · {{selected.topic}} · {{selected.time}}</view><view class="detail-title">{{selected.title}}</view><view class="summary detail-copy">{{selected.detail || selected.body}}</view>
  <image wx:for="{{selected.images}}" wx:key="*this" class="post-image" src="{{item}}" mode="widthFix"/><view class="detail-actions"><text bindtap="hug" class="{{selected.hugged ? 'teal' : ''}}">{{selected.hugged ? '已抱抱' : '抱抱'}} {{selected.hugs}}</text><text>评论 {{selected.comments}}</text><text bindtap="collect" class="{{saved ? 'teal' : ''}}">{{saved ? '已收藏' : '收藏'}}</text></view>
  <view class="section-title result-heading">回复 {{replies.length}}</view><view wx:for="{{replies}}" wx:key="index" class="reply-card"><view class="author">{{item.name}} <text class="muted meta">{{item.time}}</text></view><view class="summary">{{item.body}}</view></view><view wx:if="{{!replies.length}}" class="empty">来留下第一份回应吧。</view>
  <view class="reply-box"><input value="{{reply}}" maxlength="300" placeholder="写下你的回应…" bindinput="inputReply"/><button bindtap="sendReply">发送</button></view>
 </view>
 <view wx:elif="{{screen === 'article'}}">
  <view class="page-header"><text class="back" bindtap="back">‹</text><text>知识</text><text></text></view>
  <view class="teal article-category">{{selected.category}}</view><view class="detail-title">{{selected.title}}</view><view class="summary detail-copy">{{selected.summary}}</view>
  <view wx:for="{{selected.steps}}" wx:key="title" class="step"><text class="step-number">{{index + 1}}.</text><view><view class="article-title">{{item.title}}</view><view class="summary">{{item.body}}</view></view></view>
  <view class="muted editorial-note">示例内容 · 待专业审核<view>正式发布时展示来源与更新时间</view></view>
  <view class="setting-row" bindtap="discussion"><text class="section-title">相关讨论</text><text class="teal">大家如何准备复查 ›</text></view><view class="detail-actions"><text bindtap="collect" class="{{saved ? 'teal' : ''}}">{{saved ? '已收藏' : '收藏'}}</text><text bindtap="share">复制分享</text></view>
 </view>
</view>

