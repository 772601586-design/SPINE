.image-row{display:flex;gap:14rpx;flex-wrap:wrap;padding-bottom:35rpx}.add-image{border:2rpx dashed #dedee7;border-radius:12rpx;color:#9297a5;padding:22rpx 16rpx;font-size:24rpx}.image-wrap{position:relative}.image-wrap image{width:110rpx;height:110rpx;border-radius:10rpx}.image-wrap text{position:absolute;right:0;top:0;background:#263142a0;color:white;padding:0 9rpx;border-radius:6rpx}.post-image{width:100%;border-radius:14rpx;margin-bottom:20rpx}
.community-page{padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}.publish-fab{bottom:calc(155rpx + env(safe-area-inset-bottom))}
.post-actions{align-items:center;margin-top:18rpx}
.post-action{display:flex;align-items:center;gap:10rpx;min-height:64rpx;white-space:nowrap}
.reaction-icon{width:32rpx;height:32rpx;flex-shrink:0}
.detail-actions .post-action{flex:1;justify-content:center;border-right:1rpx solid #dedee7}
.detail-actions .post-action text{flex:initial;border:0;text-align:left}
.compose-topics{display:flex;gap:18rpx;margin:28rpx 0}
.compose-topic{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;min-height:72rpx;padding:0 16rpx;border:2rpx solid #e6ecea;border-radius:40rpx;background:#f5f7f6;color:#7d8493;font-size:29rpx;font-weight:500;box-sizing:border-box}
.compose-topic.chosen{background:#e8f4f3;color:#138984;border-color:#138984;font-weight:600}
.post-topics{display:flex;flex-wrap:wrap;gap:10rpx}
.post-topics .topic{overflow-wrap:anywhere;max-width:100%;box-sizing:border-box}
.detail-topics{margin:0 0 26rpx}
.compose-extra-topics{padding:24rpx 0;border-bottom:1rpx solid #ebeaf0}
.compose-topic-label{font-size:27rpx}
.compose-tag-list{margin-top:16rpx}
.compose-tag{display:flex;align-items:center;gap:12rpx}
.compose-tag>text{min-width:0;overflow-wrap:anywhere}
.remove-tag{display:flex;align-items:center;justify-content:center;min-width:40rpx;min-height:40rpx;flex-shrink:0;font-size:28rpx}
.compose-tag-entry{display:flex;align-items:center;gap:12rpx;margin-top:16rpx}
.tag-hash{color:#138984;font-size:30rpx}
.compose-tag-entry input{flex:1;min-width:0;height:64rpx;font-size:26rpx;color:#263142}
.compose-tag-entry .add-tag{flex:0 0 100rpx;width:100rpx;min-width:100rpx;margin:0;padding:0;min-height:60rpx;line-height:60rpx;border-radius:30rpx;background:#e8f4f3;color:#138984;font-size:25rpx}
.add-tag::after,.compose-button::after{border:0}
.compose-actions{display:flex;align-items:stretch;gap:20rpx;margin-top:28rpx}
.compose-actions .compose-button{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;width:0;height:88rpx;box-sizing:border-box;margin:0;padding:0 16rpx;border:0;border-radius:18rpx;background:#108a85;color:#fff;font-size:29rpx;font-weight:600;line-height:1}
.management-page{background:#f3f5f2;min-height:100vh;box-sizing:border-box}
.management-intro{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:32rpx 0 24rpx;font-size:26rpx;color:#5b6663}
.managed-post{background:#fff;border-radius:28rpx;padding:26rpx;margin-bottom:24rpx}
.managed-post-meta{display:flex;justify-content:space-between;align-items:center;gap:16rpx;color:#8a9590;font-size:23rpx}
.audience-label{padding:7rpx 16rpx;border-radius:24rpx;background:#e8f4f3;color:#138984;white-space:nowrap}
.audience-private{background:#f0f1f4;color:#717787}
.managed-post-body{font-size:29rpx;line-height:1.65;margin:22rpx 0;white-space:pre-wrap;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.managed-post-images{display:flex;gap:14rpx;margin-bottom:20rpx}
.managed-post-images image{width:140rpx;height:140rpx;border-radius:14rpx}
.management-actions{display:flex;align-items:center;gap:16rpx;margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid #eef2f0}
.management-actions button{flex:1;width:0;min-width:0;margin:0;padding:0 12rpx;height:64rpx;line-height:64rpx;border-radius:16rpx;background:#edf5f3;color:#23746b;font-size:25rpx;font-weight:500}
.management-actions button::after{border:0}
.management-actions .manage-delete{color:#ad5555;background:#fbf0ef}
.management-empty{display:flex;flex-direction:column;align-items:center;gap:20rpx;text-align:center;padding:80rpx 40rpx;background:#fff;border-radius:28rpx;color:#7d8783;font-size:26rpx;line-height:1.7}
.management-empty-title{font-size:32rpx;font-weight:600;color:#26372f}
