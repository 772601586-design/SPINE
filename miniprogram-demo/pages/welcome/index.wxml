<view class="welcome-page">
  <view class="welcome-header">
    <view class="welcome-brand">
      <view class="welcome-brand-mark">
        <image src="data:image/svg+xml;base64," class="welcome-brand-icon" />
      </view>
      <text class="welcome-brand-name">Spine</text>
    </view>
    <text class="welcome-step">1 / 4</text>
  </view>

  <view class="welcome-banner">
    <view class="welcome-sun" aria-hidden="true"></view>
    <view class="welcome-hill" aria-hidden="true"></view>
    <view class="welcome-greeting">
      <text class="welcome-bubble">嗨，我是小枝</text>
      <text class="welcome-title">很高兴认识你！</text>
    </view>
    <image class="welcome-mascot" src="/assets/brand/xiaozhi-mascot-v1.png" mode="aspectFit" aria-hidden="true" />
  </view>

  <view class="welcome-card">
    <view class="welcome-card-heading">
      <text class="welcome-card-title">出生年月</text>
      <button wx:if="{{ birthMonth }}" class="welcome-clear" bindtap="clearBirthMonth">清除</button>
      <text wx:else class="welcome-card-note">选填</text>
    </view>
    <picker mode="date" fields="month" value="{{ birthMonth || currentMonth }}" start="1900-01" end="{{ currentMonth }}" bindchange="onBirthMonth">
      <view class="welcome-month">
        <text class="{{ birthMonth ? 'welcome-month-value' : 'welcome-month-placeholder' }}">{{ birthMonthLabel || '选择出生年月' }}</text>
        <view class="welcome-chevron" aria-hidden="true"></view>
      </view>
    </picker>
  </view>

  <view class="welcome-actions">
    <button class="welcome-next" bindtap="act" data-fn="{{ nav.stageFromStart }}" hover-class="tap">下一步</button>
    <button class="welcome-login" bindtap="act" data-fn="{{ nav.today }}" hover-class="tap">已有账号，直接登录</button>
  </view>
</view>
