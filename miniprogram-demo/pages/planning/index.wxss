.planning-page{padding:28rpx 30rpx calc(160rpx + env(safe-area-inset-bottom));box-sizing:border-box;min-height:100vh}
.planning-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-width:0}
.planning-title{font-size:32rpx;font-weight:700;line-height:1.4;color:#1f2a27}
.planning-link{font-size:25rpx;line-height:1.5;font-weight:600;color:#1f6f66;padding:12rpx 0;flex-shrink:0}
.schedule-link{white-space:nowrap}
.material-grid{display:flex;align-items:flex-start;gap:18rpx;margin-top:22rpx}
.material-area{flex:1;min-width:0;overflow:hidden;background:#fff;border-radius:24rpx;padding:0 20rpx;box-sizing:border-box}
.material-entry{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:220rpx;box-sizing:border-box;min-width:0;margin:0;padding:20rpx 0;border-radius:20rpx;background:transparent;color:#1f2a27;line-height:1.5;font-weight:400;text-align:center}
.retry-button::after{border:0}
.material-entry-disabled{opacity:.55}
.material-entry-pressed{opacity:.65}
.entry-icon-wrap{height:70rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;width:100%;margin-bottom:10rpx}
.camera-icon{position:relative;top:6rpx;width:68rpx;height:50rpx;border:3rpx solid #1f6f66;border-radius:10rpx;box-sizing:border-box}
.camera-icon::before{content:"";position:absolute;top:-12rpx;left:15rpx;width:26rpx;height:10rpx;border:3rpx solid #1f6f66;border-bottom:0;border-radius:6rpx 6rpx 0 0;background:#fff}
.camera-icon::after{content:"";position:absolute;top:7rpx;right:6rpx;width:5rpx;height:5rpx;border-radius:50%;background:#1f6f66}
.camera-lens{position:absolute;top:9rpx;left:18rpx;width:26rpx;height:26rpx;border:3rpx solid #1f6f66;border-radius:50%;box-sizing:border-box}
.folder-icon{position:relative;top:6rpx;width:68rpx;height:50rpx;border:3rpx solid #1f6f66;border-radius:7rpx;box-sizing:border-box}
.folder-icon::before{content:"";position:absolute;top:-12rpx;left:-3rpx;width:28rpx;height:10rpx;border:3rpx solid #1f6f66;border-bottom:0;border-radius:6rpx 6rpx 0 0;background:#fff}
.folder-front{position:absolute;top:8rpx;left:-3rpx;right:-3rpx;bottom:-3rpx;background:#e4f0eb;border:3rpx solid #1f6f66;border-radius:4rpx 4rpx 7rpx 7rpx;box-sizing:border-box}
.material-title{display:block;font-size:28rpx;font-weight:650;line-height:1.4}
.material-hint{display:block;font-size:21rpx;color:#718078;margin-top:4rpx;line-height:1.45}
.material-items{display:block;height:300rpx;width:100%;box-sizing:border-box;overflow-x:hidden;overflow-y:auto;margin:0 0 24rpx;border-top:1rpx solid #e8ede8;padding-top:18rpx}
.material-name{display:block;flex:1;min-width:0;font-size:23rpx;font-weight:500;line-height:1.6;word-break:break-all;overflow-wrap:anywhere}
.material-chevron{flex-shrink:0;color:#718078;font-size:28rpx}
.file-item+.file-item{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #e8ede8}
.file-heading{display:flex;align-items:center;gap:10rpx;margin-bottom:8rpx}
.document-icon{width:23rpx;height:29rpx;border:2rpx solid #76978c;border-radius:3rpx;padding:8rpx 4rpx 0;box-sizing:border-box;flex-shrink:0}
.document-icon view{height:2rpx;background:#76978c;margin-bottom:5rpx}
.file-kind{font-size:20rpx;line-height:1.4;color:#718078;word-break:break-all}
.file-name{font-size:23rpx}
.file-status{display:block;margin-top:8rpx;font-size:20rpx;line-height:1.6;color:#1f6f66;word-break:break-all}
.file-status-error{color:#a36743}
.file-error{display:block;color:#a36743;font-size:20rpx;line-height:1.5;margin-top:6rpx;word-break:break-all}
.retry-button{display:inline-block;width:auto;margin:12rpx 0 0;padding:8rpx 16rpx;color:#1f6f66;border-radius:20rpx;background:#e8f1ed;font-size:21rpx;line-height:1.5;font-weight:500}
.retry-button[disabled]{background:#eff3f0;color:#87978e}
.import-progress{display:flex;align-items:center;gap:12rpx;padding:20rpx 24rpx;margin-top:18rpx;background:#e4efea;border-radius:18rpx;color:#1f6f66;font-size:24rpx;line-height:1.6}
.progress-dot{width:12rpx;height:12rpx;border-radius:50%;background:#1f6f66;flex-shrink:0}
.import-hint{display:block;margin:20rpx 4rpx 0;color:#7b8981;font-size:22rpx;line-height:1.7}
.action-section{margin-top:34rpx}
.action-heading{margin-bottom:20rpx}
.action-title-row{display:flex;align-items:center;gap:14rpx;min-width:0}
.action-count{color:#718078;font-size:23rpx;white-space:nowrap}
.action-group+.action-group{margin-top:32rpx}
.group-heading{display:flex;align-items:center;gap:10rpx;margin:10rpx 4rpx 14rpx;font-size:26rpx;font-weight:600;color:#42554b}
.group-marker{width:6rpx;height:24rpx;background:#72a396;border-radius:4rpx;flex-shrink:0}
.group-count{font-size:22rpx;font-weight:400;color:#8a978f;margin-left:auto;white-space:nowrap}
.action-card{padding:26rpx;border-radius:26rpx;background:#fff;box-sizing:border-box;overflow:hidden}
.action-card+.action-card{margin-top:18rpx}
.action-card-pressed{background:#f9fbf9}
.action-card-heading{display:flex;align-items:flex-start;gap:16rpx;justify-content:space-between}
.action-name{min-width:0;flex:1;font-size:31rpx;font-weight:650;line-height:1.5;word-break:break-all}
.action-chevron{font-size:34rpx;line-height:1.35;color:#8b9a91;flex-shrink:0}
.action-labels{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}
.action-group-label,.action-status{font-size:21rpx;line-height:1.5;padding:5rpx 12rpx;border-radius:12rpx;background:#f1f4f1;color:#718078;word-break:break-all}
.action-status{background:#faf0e4;color:#986745}
.action-status-ready{background:#e5f0eb;color:#1f6f66}
.action-detail{display:flex;align-items:flex-start;gap:20rpx;margin-top:22rpx}
.detail-label{font-size:23rpx;line-height:1.7;color:#7a8980;width:98rpx;flex-shrink:0}
.detail-value{min-width:0;flex:1;font-size:25rpx;line-height:1.7;color:#30453a;white-space:pre-wrap;word-break:break-all}
.detail-placeholder{color:#9a9387}
.action-notes{margin-top:12rpx}
.action-card-footer{display:flex;align-items:flex-end;justify-content:space-between;gap:12rpx;border-top:1rpx solid #edf0ec;margin-top:24rpx;padding-top:18rpx}
.action-badges{display:flex;flex:1;min-width:0;flex-wrap:wrap;gap:8rpx}
.source-badge,.schedule-badge{display:block;max-width:100%;box-sizing:border-box;font-size:20rpx;line-height:1.6;color:#718078;word-break:break-all}
.source-badge{background:#f3f5f2;border-radius:8rpx;padding:3rpx 10rpx}
.schedule-badge{color:#1f6f66;padding:3rpx 0}
.action-video-label{font-size:21rpx;line-height:1.6;color:#1f6f66;flex-shrink:0;padding:3rpx 0}
.actions-empty{display:flex;flex-direction:column;align-items:center;padding:42rpx 32rpx 30rpx;background:#fff;border-radius:28rpx;text-align:center}
.empty-card-icon{width:60rpx;height:70rpx;box-sizing:border-box;border:3rpx solid #9cb6a8;border-radius:9rpx;padding:20rpx 11rpx 0;margin-bottom:22rpx}
.empty-card-icon view{height:3rpx;margin-bottom:9rpx;background:#9cb6a8;border-radius:2rpx}
.empty-card-icon view:last-child{width:70%}
.empty-title{display:block;font-size:28rpx;font-weight:600;color:#42554b}
.empty-description{display:block;font-size:23rpx;line-height:1.8;color:#849188;margin-top:10rpx}
.empty-create{margin-top:12rpx}
.file-review { display: block; margin-top: 16rpx; font-size: 23rpx; }
.schedule-panel{margin-top:18rpx;background:#fff;padding:18rpx 24rpx;border-radius:24rpx}
.schedule-panel-title{font-size:27rpx;font-weight:600;color:#42554b}
.schedule-items{height:320rpx}
.schedule-item{display:flex;align-items:center;gap:14rpx;padding:20rpx 0;border-top:1rpx solid #edf0ec}
.schedule-item-main{flex:1;min-width:0}
.schedule-name{display:block;font-size:25rpx;line-height:1.6;color:#30453a;word-break:break-all}
.schedule-meta{display:block;font-size:22rpx;line-height:1.7;color:#7b8981;margin-top:5rpx;word-break:break-all}
