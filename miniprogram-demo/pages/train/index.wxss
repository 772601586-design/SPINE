page {
  height: 100%;
  overflow: hidden;
}
.brace-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  margin: 20rpx 0;
  padding: 12rpx 26rpx;
  border-radius: 28rpx;
  background: #fff;
}
.brace-summary { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.brace-icon { width: 48rpx; height: 60rpx; flex-shrink: 0; }
.brace-summary-time { color: #718078; font-size: 26rpx; font-weight: 400; line-height: 1.5; white-space: nowrap; font-variant-numeric: tabular-nums; }
.brace-bar .brace-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1;
  overflow: visible;
}
.brace-toggle::after { border: 0; }
.brace-toggle-track {
  position: relative;
  width: 102rpx;
  height: 62rpx;
  border-radius: 62rpx;
  background: #e3eae5;
  transition: background-color 180ms ease;
}
.brace-toggle-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(31, 111, 102, 0.12);
  transition: transform 180ms ease;
}
.brace-toggle-on .brace-toggle-track { background: #1f6f66; }
.brace-toggle-on .brace-toggle-thumb { transform: translateX(40rpx); }
.training-task {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e3eae5;
}
.training-task-name { display:block; font-size:31rpx; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.training-group { margin-top:28rpx; }
.training-group-header { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:14rpx 18rpx; background:#edf4f0; border-radius:12rpx; }
.training-group-title { font-size:27rpx; font-weight:600; color:#1f6f66; }
.training-group-count { flex-shrink:0; font-size:22rpx; color:#718078; }
.training-task-done { text-decoration:line-through; text-decoration-thickness:2rpx; color:#7b8982; }
.training-task-dose { display:block; margin-top:14rpx; color:#718078; font-size:25rpx; font-weight:500; line-height:1.6; }
.training-task-notes { display:block; margin-top:8rpx; color:#718078; font-size:23rpx; line-height:1.7; }
.training-task-status { display:block; margin-top:8rpx; color:#718078; font-size:23rpx; }
.training-check { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:38rpx; height:38rpx; border:2rpx solid #9cb4a7; border-radius:50%; font-size:23rpx; }
.training-checked { background:#1f6f66; color:#fff; border-color:#1f6f66; }
.training-task-progress { height:7rpx; margin-top:12rpx; background:#e9efeb; border-radius:5rpx; overflow:hidden; }
.training-task-progress view { height:100%; background:#1f6f66; border-radius:5rpx; }
.training-task .training-start {
  display: inline-flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 48rpx;
  box-sizing: border-box;
  margin: 0 -12rpx 0 auto;
  padding: 0;
  border-radius: 24rpx;
  background: #1f6f66;
  color: #fff;
  font-size: 22rpx;
  line-height: 48rpx;
  white-space: nowrap;
}
.training-start::after { border:0; }

.training-screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.training-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.training-content {
  padding: 16rpx 30rpx calc(146rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
