page {
  height: 100%;
  overflow: hidden;
}
.training-task {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e3eae5;
}
.training-task-name { display:block; font-size:31rpx; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.training-group { margin-top:28rpx; }
.training-group-header { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:14rpx 18rpx; background:#edf4f0; border-radius:12rpx; }
.training-group-title { font-size:27rpx; font-weight:600; color:#1f6f66; }
.training-group-count { flex-shrink:0; font-size:22rpx; color:#718078; }
.training-task-done { text-decoration:line-through; text-decoration-thickness:2rpx; color:#7b8982; }
.training-task-dose { display:block; margin-top:14rpx; color:#718078; font-size:25rpx; font-weight:500; line-height:1.6; }
.training-task-notes { display:block; margin-top:8rpx; color:#718078; font-size:23rpx; line-height:1.7; }
.training-task-status { display:block; margin-top:8rpx; color:#718078; font-size:23rpx; }
.training-check { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:38rpx; height:38rpx; border:2rpx solid #9cb4a7; border-radius:50%; font-size:23rpx; }
.training-checked { background:#1f6f66; color:#fff; border-color:#1f6f66; }
.training-task-progress { height:7rpx; margin-top:12rpx; background:#e9efeb; border-radius:5rpx; overflow:hidden; }
.training-task-progress view { height:100%; background:#1f6f66; border-radius:5rpx; }
.training-task .training-start {
  display: inline-flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 48rpx;
  box-sizing: border-box;
  margin: 0 -12rpx 0 auto;
  padding: 0;
  border-radius: 24rpx;
  background: #1f6f66;
  color: #fff;
  font-size: 22rpx;
  line-height: 48rpx;
  white-space: nowrap;
}
.training-start::after { border:0; }

.training-screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.training-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.training-content {
  padding: 16rpx 30rpx calc(146rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
