<view class="training-screen">
  <scroll-view class="training-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
  <view class="training-content">
  <view wx:if="{{error}}" class="flow-error">{{error}}</view>
  <view wx:if="{{braceEnabled}}" class="brace-bar">
    <image class="brace-icon" mode="aspectFit" aria-hidden="true" src="data:image/svg+xml;base64," />
    <button class="brace-toggle {{braceWearing ? 'brace-toggle-on' : ''}}" bindtap="toggleBraceRecord" hover-class="none" aria-role="switch" aria-label="支具佩戴" aria-checked="{{braceWearing}}">
      <view class="brace-toggle-track"><view class="brace-toggle-thumb"></view></view>
    </button>
  </view>
  <view wx:if="{{braceError}}" class="flow-error">{{braceError}}</view>
  <view class="flow-card"><view class="flow-row"><text class="flow-heading">当日训练清单</text><text class="flow-pill">已完成 {{complete}} / {{total}}</text></view><text class="flow-muted">按已确认的计划顺序练习</text>
    <view wx:if="{{!records.length}}" class="flow-empty">这一天暂无安排，可到“制定”页面的“计划与日程”安排训练。</view>
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="name" class="training-group">
      <view class="training-group-header"><text class="training-group-title">{{group.number}}. {{group.name}}</text><text class="training-group-count">{{group.complete}} / {{group.rows.length}}</text></view>
      <view wx:for="{{group.rows}}" wx:key="rowId" class="training-task">
        <view class="training-check {{item.completed ? 'training-checked' : ''}}">{{item.completed ? '✓' : ''}}</view>
        <view class="flow-flex"><text class="training-task-name {{item.guidedDone || item.completed ? 'training-task-done' : ''}}">{{item.number}}. {{item.name}}</text><text class="training-task-dose">{{item.ready ? item.dose : '资料待核对'}}</text><text wx:if="{{item.notes}}" class="training-task-notes">{{item.notes}}</text><text wx:if="{{item.completed || item.progress}}" class="training-task-status">{{item.completed ? '已完成' : '部分完成 · 已记录 ' + item.progress + ' / ' + item.sets + ' 组'}}</text><view wx:if="{{item.progress}}" class="training-task-progress"><view style="width:{{item.progress >= item.sets ? 100 : item.progress / item.sets * 100}}%"></view></view></view>
        <button class="training-start" data-plan="{{item.planId}}" data-card="{{item.cardId}}" bindtap="startExercise">开始</button>
      </view>
    </view>
  </view><text class="flow-small">圆圈表示本次要求已完成，部分完成记录实际量</text>
  </view>
  </scroll-view>
</view>

<view style="padding:24rpx"><button bindtap="openKnowledge">了解 Schroth 训练原理</button></view>
