/* 全局样式：页面样式大多写在各页 WXML 的 style 里（由交互原型转换而来） */
page {
  background: #F3F5F2;
  color: #1F2A27;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
/* 可点区域按下时的反馈 */
.tap { opacity: 0.6; }


.flow-page{padding:36rpx 30rpx 70rpx}.flow-title{display:block;font-size:46rpx;font-weight:700}.flow-heading{display:block;font-size:30rpx;font-weight:600}.flow-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.flow-flex{flex:1;min-width:0}.flow-muted{display:block;color:#718078;font-size:25rpx;margin:12rpx 0}.flow-small{display:block;color:#718078;font-size:22rpx;margin:10rpx 0}.flow-subhead{margin:28rpx 0}.flow-link{color:#1f6f66;font-size:25rpx;font-weight:600;padding:10rpx 0}.flow-week{display:flex;gap:10rpx;margin:24rpx 0}.flow-day{flex:1;text-align:center;padding:14rpx 0;border-radius:22rpx;background:white;color:#718078;font-size:22rpx;display:flex;flex-direction:column;align-items:center}.flow-day-number{font-size:30rpx;font-weight:600;color:#1f2a27}.flow-selected{background:#1f6f66!important;color:white!important}.flow-selected .flow-day-number{color:white}.flow-card{background:white;border-radius:28rpx;padding:26rpx;margin:20rpx 0}.flow-pill{display:inline-block;background:#ddede9;color:#1f6f66;font-size:22rpx;border-radius:25rpx;padding:8rpx 18rpx;margin:10rpx 0}.flow-task{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #e3eae5}.flow-check{width:38rpx;height:38rpx;border:2rpx solid #9cb4a7;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}.flow-checked{background:#1f6f66;color:white;border-color:#1f6f66}.flow-button{background:#1f6f66;color:white;border-radius:20rpx;margin:24rpx 0 12rpx;font-size:29rpx;font-weight:600}.flow-button::after,.flow-mini::after{border:0}.flow-secondary{background:#e8f0eb;color:#1f6f66}.flow-mini{margin:0;background:white;color:#1f6f66;padding:0 22rpx;border-radius:30rpx;font-size:25rpx;line-height:2.3}.flow-progress{height:7rpx;background:#e9efeb;border-radius:5rpx;margin:12rpx 0}.flow-progress view{height:7rpx;background:#1f6f66;border-radius:5rpx}.flow-actions{justify-content:space-around;margin-top:16rpx}.flow-section{margin-top:44rpx}.flow-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.flow-grid .flow-card{margin-bottom:0}.flow-draft{background:#f7eee3}.flow-input{box-sizing:border-box;width:100%;background:#f3f5f2;border-radius:16rpx;padding:20rpx;margin:14rpx 0;min-height:82rpx}.flow-label{display:block;color:#718078;font-size:24rpx;margin-top:24rpx}.flow-tabs{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.flow-tabs text{padding:14rpx 24rpx;background:#e4ebe5;border-radius:16rpx;font-size:25rpx}.flow-body{display:block;margin:20rpx 0}.flow-error{padding:22rpx;color:#9a4837;background:#f7e8e2;border-radius:18rpx;margin:16rpx 0}.flow-empty{padding:40rpx 10rpx;text-align:center;color:#718078}.flow-video{width:100%;height:350rpx;border-radius:22rpx;margin:20rpx 0}.flow-ring{width:240rpx;height:240rpx;border:15rpx solid #ddede9;border-top-color:#1f6f66;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:62rpx;color:#1f6f66;margin:36rpx auto}.flow-ring text{font-size:24rpx}.flow-bars{display:flex;align-items:flex-end;gap:18rpx;height:160rpx;margin:20rpx 0}.flow-bar-col{flex:1;text-align:center;color:#718078;font-size:22rpx}.flow-bar{height:110rpx;background:#eff3ee;border-radius:10rpx;display:flex;align-items:flex-end}.flow-bar view{width:100%;min-height:3rpx;background:#1f6f66;border-radius:10rpx}
