        <view style="display: flex; flex-direction: column; gap: 3.85rpx">
          <text style="font-size: 23.08rpx; color: #5B6663">训练</text>
          <text style="font-size: 32.69rpx; font-weight: 700">{{ doneCount }} / {{ deckLen }} 个</text>
          <text style="font-size: 21.15rpx; color: #5B6663">{{ coreDayText }}</text>
