      <view style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; min-height: 84.62rpx; border: 2.88rpx solid #1F6F66; border-radius: 23.08rpx; background: transparent; color: #1F6F66; font-size: 26.92rpx; font-weight: 700" bindtap="act" data-fn="{{ makeSummary }}" hover-class="tap">生成复查前摘要</view>
