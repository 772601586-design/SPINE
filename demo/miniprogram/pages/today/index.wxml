  <block wx:if="{{ st.braceRings }}">
    <view style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 19.23rpx">
      <view style="display: flex; align-items: center; gap: 19.23rpx; padding: 23.08rpx; border: 0; border-radius: 34.62rpx; background: #FFFFFF; color: #1F2A27; text-align: left" bindtap="act" data-fn="{{ nav.brace }}" hover-class="tap">
        <image src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='60'%20height='60'%20viewBox='0%200%2064%2064'%20style='flex-shrink:%200'%3E%3Ccircle%20cx='32'%20cy='32'%20r='26'%20fill='none'%20stroke='%23DCE5E1'%20stroke-width='8'%3E%3C/circle%3E%3Ccircle%20cx='32'%20cy='32'%20r='26'%20fill='none'%20stroke='%231F6F66'%20stroke-width='8'%20stroke-linecap='round'%20stroke-dasharray='{{ u.enc(braceDash) }}'%20transform='rotate(-90%2032%2032)'%3E%3C/circle%3E%3C/svg%3E" style="width: 115.38rpx; height: 115.38rpx; flex-shrink: 0; flex-shrink: 0" />
