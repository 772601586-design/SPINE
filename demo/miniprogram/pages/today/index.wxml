      <view style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; align-self: flex-start; min-height: 69.23rpx; padding: 0 23.08rpx; border: 0; border-radius: 1921.15rpx; background: #FFFFFF; color: #1F6F66; font-size: 25rpx; font-weight: 700" bindtap="act" data-fn="{{ nav.talk }}" hover-class="tap">看看大家怎么熬过前两周 ›</view>
