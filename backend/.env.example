# Local development only. Run python bootstrap_env.py to create .env with random secrets.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
POSTGRES_DB=spine
POSTGRES_USER=spine
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=3
# Development-only personal accounts; leave blank to enter a password interactively.
SPINE_DEV_PASSWORD=

# 微信小程序登录。AppID 可以公开；AppSecret 只存在于服务端，禁止提交或下发客户端。
WECHAT_APPID=
WECHAT_APPSECRET=

# 私有对象存储（医疗附件/私人记录/社区媒体）。本地实现；生产可改 STORAGE_BACKEND=s3 等。
STORAGE_BACKEND=local
PRIVATE_STORAGE_ROOT=
# 授权访问地址有效期（秒）。过期后必须重新换取。
ATTACHMENT_ACCESS_TTL_SECONDS=300
# 一次就诊最多挂多少个附件。
VISIT_MAX_ATTACHMENTS=20
