{
	"nodes":[
		{"id":"8386396d2fedb918","type":"text","text":"青少年（高强度治疗群体）","x":-333,"y":-301,"width":250,"height":60,"color":"5"},
		{"id":"ca270a3c364df1a7","type":"text","text":"长期坚持佩戴支具+锻炼，在发育期控制侧弯度数","x":6,"y":-608,"width":250,"height":60},
		{"id":"31d4aee26082b0b9","type":"text","text":"核心治疗目标","x":-284,"y":-400,"width":153,"height":50,"color":"4"},
		{"id":"aaea3aff33547530","type":"text","text":"注重结合按摩和游泳等运动进行肌肉松解和皮肤保护","x":445,"y":-578,"width":250,"height":60},
		{"id":"2562df026e404651","type":"text","text":"考虑支具对饮食和月经周期的影响","x":445,"y":-400,"width":250,"height":60},
		{"id":"cb57b2dc3923f699","type":"text","text":"患者在学校佩戴支具的心理因素","x":445,"y":-220,"width":250,"height":60},
		{"id":"e1435e73f3c90dd6","type":"text","text":"帮助患者减轻开始佩戴支具这个过程的痛苦，从而减少对支具和治疗的抵触感，鼓励患者长期坚持","x":774,"y":-640,"width":221,"height":122},
		{"id":"935e9a68fa8bd059","type":"text","text":"记录支具佩戴时长","x":60,"y":-400,"width":250,"height":60},
		{"id":"58cc10ff8f0fa74c","type":"text","text":"抗炎饮食&正念饮食","x":795,"y":-500,"width":200,"height":60},
		{"id":"98e1251a2c333499","type":"text","text":"少食多餐","x":840,"y":-395,"width":110,"height":50},
		{"id":"09d1a3f1b7e580ad","type":"text","text":"结合运动和饭前放松","x":799,"y":-301,"width":192,"height":50},
		{"id":"f26cb9528013c839","type":"text","text":"社群搭建（deco）&科普知识","x":799,"y":-150,"width":221,"height":70},
		{"id":"932e0970e03660ce","type":"text","text":"脊柱状况跟踪","x":60,"y":0,"width":250,"height":60},
		{"id":"07f2260db569369a","type":"text","text":"阶段性获得成就感，但是要避免患者的焦虑感","x":785,"y":0,"width":250,"height":60},
		{"id":"9712e846e304b3bb","type":"text","text":"康复期：支具+运动，重点在于长期的支具佩戴和高强度运动","x":2120,"y":-80,"width":240,"height":99},
		{"id":"dbfadaee77a4c858","type":"text","text":"患者的生长发育期逐渐停止，脱掉支具以运动为主。这段时期脊柱的度数会反弹，旋转患者反弹程度更大。","x":2520,"y":-111,"width":240,"height":162},
		{"id":"2e6f8e209275eaba","type":"text","text":"发现侧弯：分析度数，定制支具。理想情况在月经开始之前（也就是身高定型之前）","x":1720,"y":-97,"width":229,"height":134},
		{"id":"a69a26c8cffc03cb","type":"text","text":"问题点：脊柱侧弯治疗有不同的治疗周期","x":1300,"y":-60,"width":250,"height":60,"color":"2"},
		{"id":"aa46d5141920ecfb","type":"text","text":"核心治疗目标","x":-203,"y":960,"width":144,"height":50,"color":"4"},
		{"id":"8e76143e6908d90c","type":"text","text":"贯穿整个青春期，患者在学业和身体上面临很大压力，需要关注心理因素，难以坚持","x":2120,"y":120,"width":238,"height":120},
		{"id":"ac621e5b57c21287","type":"text","text":"自我管控，终身坚持，体态改善","x":2498,"y":120,"width":285,"height":50},
		{"id":"221f6f1822becdb4","type":"text","text":"上传初始资料，年龄也要纳入分析","x":1684,"y":125,"width":301,"height":55},
		{"id":"7542a13cbf78c683","type":"text","text":"定期回诊，上传身高，度数等疾病记录，让身体改变痕迹可视化","x":445,"y":-20,"width":250,"height":100},
		{"id":"af4e9e3b131bfad0","type":"text","text":"功能支持：施罗斯动作","x":445,"y":120,"width":250,"height":60},
		{"id":"c1a62e83eef65aad","type":"text","text":"呼吸配合节奏","x":445,"y":213,"width":250,"height":60},
		{"id":"63bd19dfaea29b5f","type":"text","text":"做组","x":445,"y":306,"width":250,"height":50},
		{"id":"0d628fa2e2e7cd2b","type":"text","text":"康复运动打卡","x":60,"y":213,"width":250,"height":60},
		{"id":"f2ba624879e042b5","type":"text","text":"问题点：这两类用户在打卡机制上是否应该进行区分？","x":2320,"y":317,"width":245,"height":78,"color":"2"},
		{"id":"d063c27662dff9a1","type":"text","text":"打卡奖励机制","x":60,"y":770,"width":250,"height":50},
		{"id":"f25765990caf02f2","type":"text","text":"松果货币，可兑换产品","x":476,"y":730,"width":250,"height":60},
		{"id":"15b6793a8df7cf6a","type":"text","text":"勋章奖励","x":476,"y":820,"width":250,"height":60},
		{"id":"9a285fa7746efaad","type":"text","text":"问题点：如何对不同的打卡项目设计分别的奖励，饮食支具运动是否分开打卡\n","x":910,"y":760,"width":241,"height":101,"color":"2"},
		{"id":"2fa1bd48826269c8","type":"text","text":"核心功能","x":-800,"y":223,"width":250,"height":60,"color":"3"},
		{"id":"5d0427871563b543","type":"text","text":"成年人（自主治疗群体）","x":-256,"y":820,"width":250,"height":60,"color":"5"},
		{"id":"f9009aa2032a5958","type":"text","text":"问题点：如何让打卡功能在达到上述功能要求的同时保持简洁轻量化？动作示范资料是否要个人上传或建立专业档案？","x":1151,"y":170,"width":250,"height":146,"color":"2"},
		{"id":"0653decaf172fea3","type":"text","text":"社群功能","x":1726,"y":613,"width":250,"height":60},
		{"id":"4e5591ad2737541b","type":"text","text":"问题点：如何打造，是否需要建立搭档打卡","x":2221,"y":608,"width":222,"height":65,"color":"2"},
		{"id":"6b770a1196b63261","type":"text","text":"保持脊柱健康，长期伏案工作导致身体疼痛，影响日常生活运动","x":60,"y":1120,"width":271,"height":86},
		{"id":"5912b7605e1b4549","type":"text","text":"辅助运动，如游泳等","x":60,"y":500,"width":250,"height":60},
		{"id":"19e70de290d2bae0","type":"text","text":"问题点：功能是否必要？处于什么样的位置？怎样呈现给用户？","x":538,"y":480,"width":257,"height":100,"color":"2"},
		{"id":"f47260dde1ec0066","x":1151,"y":395,"width":250,"height":54,"color":"2","type":"text","text":"问题点：如何和康复师一起构建个人打卡项目"}
