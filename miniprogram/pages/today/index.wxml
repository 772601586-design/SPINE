<view class="page">
  <view class="heading"><text class="title">今日</text><text class="subtitle">每一步，照顾好自己。</text></view>
  <view wx:if="{{error}}" class="error" bindtap="reload">{{error}} 点击重试</view>
  <view wx:if="{{loading}}" class="card"><view class="empty">正在读取你的记录…</view></view>
  <view class="card">
    <text class="card-title">康复任务</text>
    <view class="empty">暂未接入真实康复计划</view>
  </view>
  <view class="card">
    <text class="card-title">运动养护</text>
    <text class="muted">独立于康复计划的运动前后养护入口。</text>
    <button class="button button-plain" bindtap="showPending">查看运动养护</button>
  </view>
  <view class="card card-green brace-card" bindtap="openBrace">
    <view class="row"><text class="card-title brace-title">支具</text><text class="arrow">›</text></view>
    <block wx:if="{{braceName}}">
      <text class="brace-name">{{braceName}}</text>
      <text class="status">{{wearing ? '佩戴中' : '当前未佩戴'}}<text wx:if="{{wearing}}"> · 本次 {{elapsedText}}（实时暂计）</text></text>
      <text class="daily">{{hasTodayRecord ? '今日已记录 ' + todayText : '今日暂无记录'}}</text>
      <text class="small">时长以服务端保存的记录统计；按当前支具计算</text>
    </block>
    <view wx:else class="empty">还没有支具档案，点击添加</view>
    <view class="brace-action">{{braceName ? '打开支具管理' : '添加支具'}}　›</view>
  </view>
  <button class="button button-plain" bindtap="reload" loading="{{loading}}">刷新</button>
</view>
