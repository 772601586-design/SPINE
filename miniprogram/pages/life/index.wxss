.tabs{display:flex;flex-wrap:wrap;gap:12rpx;margin:20rpx 0}.tab{padding:14rpx 20rpx;background:#fff;border:1rpx solid #dce5df;border-radius:24rpx;color:#52665a}.tab.selected{background:#1f6f66;color:white}.field{display:block;box-sizing:border-box;width:100%;padding:22rpx;margin:16rpx 0;background:#f3f5f2;border-radius:16rpx;min-height:86rpx}.record{padding:24rpx 0;border-bottom:1rpx solid #e3e9e3}.record text{display:block}.article-body{display:block;white-space:pre-wrap;line-height:1.9;margin:24rpx 0}.drawing{width:100%;margin:20rpx 0}.medals{display:flex;flex-wrap:wrap;gap:16rpx;margin:24rpx 0}.medal{padding:20rpx;color:#809087;background:#f3f5f2;border-radius:16rpx}.medal.earned{color:#825f14;background:#faf0d8}
