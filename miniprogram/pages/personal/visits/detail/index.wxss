.label { display: block; margin: 22rpx 0 10rpx; color: #648074; font-size: 23rpx; }
.input { width: 100%; height: 44rpx; font-size: 29rpx; }
.textarea { width: 100%; height: 150rpx; font-size: 27rpx; }
.textarea.short { height: 110rpx; }
.placeholder { color: #a9b4ae; }
.picker-field { display: flex; align-items: center; justify-content: space-between; margin: 0; }
.tight { margin-bottom: 0; }
.arrow { color: #87928c; font-size: 24rpx; }
.tag { padding: 4rpx 16rpx; border-radius: 999rpx; background: #edf4ef; color: #246b57; font-size: 21rpx; }
.row.gap { gap: 18rpx; }
.compact { flex: 1; margin-top: 18rpx; }
.small-btn { font-size: 24rpx; padding: 0 12rpx; }
.link { color: #246b57; font-size: 24rpx; }
.center { display: block; margin-top: 16rpx; text-align: center; }
