<view class="page">
  <view class="heading"><text class="title">个人</text><text class="subtitle">个人资料与私人记录。</text></view>
  <view class="card"><text class="card-title">我的账号</text><text>{{username}}</text></view>
  <view class="card"><text class="card-title">健康档案与历史</text><button class="button button-plain" bindtap="openHistory">支具佩戴与感受历史</button></view>
  <view class="card"><text class="card-title">上传资料</text><view class="empty">受保护的文件上传尚未开放</view></view>
  <view class="card"><text class="card-title">偏好设置</text><view class="empty">偏好设置尚未开放</view></view>
  <button class="button button-danger" loading="{{busy}}" disabled="{{busy}}" bindtap="logout">退出登录</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
