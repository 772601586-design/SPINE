<view class="page">
  <view class="heading"><text class="title">{{editing ? '编辑支具档案' : '添加支具档案'}}</text><text class="subtitle">已有记录会保留；新增支具不会覆盖旧档案。</text></view>
  <view class="card">
    <text class="field-label">名称</text><input class="field" value="{{name}}" data-key="name" bindinput="input" placeholder="支具名称（必填）" />
    <text class="field-label">类型</text><input class="field" value="{{braceType}}" data-key="braceType" bindinput="input" placeholder="例如：胸腰骶支具" />
    <text class="field-label">开始使用日期</text><input class="field" value="{{startedOn}}" data-key="startedOn" bindinput="input" placeholder="YYYY-MM-DD" />
    <text class="field-label">配置机构</text><input class="field" value="{{institution}}" data-key="institution" bindinput="input" placeholder="可选" />
    <text class="field-label">备注</text><textarea class="field" value="{{notes}}" data-key="notes" bindinput="input" placeholder="可选" auto-height />
    <view class="switch-row"><text>在用</text><switch checked="{{isActive}}" color="#246b57" bindchange="toggleActive" /></view>
    <view wx:if="{{hasOpenWear && !isActive}}" class="error">当前支具仍有未结束佩戴记录，请先结束记录后再停用。</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="button" loading="{{busy}}" disabled="{{busy || (hasOpenWear && !isActive)}}" bindtap="save">保存</button>
  </view>
</view>
