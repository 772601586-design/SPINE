.overview { display: flex; gap: 18rpx; }
.metric { flex: 1; min-width: 0; padding: 24rpx; background: #fff; border-radius: 32rpx; }
.metric-symbol { font-size: 48rpx; color: #1f6f66; margin-bottom: 12rpx; }
.metric text { display: block; }
.metric-value { font-size: 31rpx; font-weight: 700; margin: 8rpx 0; }
.peach .metric-symbol { color: #c4602a; }
.intro-card { margin-top: 26rpx; }
.deck-card .card-title { margin: 16rpx 0 8rpx; }
.gentle-note { background: #eee9df; }
.completion-mark { color: #1f6f66; font-size: 23rpx; }
.deck-done { background: #e8efea; }
.deck-card .small { display: block; margin-top: 10rpx; }
