<view class="page">
  <view class="heading"><text class="eyebrow">{{dateLine}} · 和小树一起慢慢来</text><text class="title">{{greeting}}，{{nickname}}</text></view>
  <view wx:if="{{loading}}" class="card empty">正在整理你的记录…</view>
  <block wx:else>
    <view wx:if="{{lifeError}}" class="error" bindtap="loadLife">{{lifeError}}</view>
    <view wx:if="{{lifeSummary.review}}" class="card card-green"><text class="card-title">复查准备 · {{lifeSummary.review.date}}</text><text class="muted">{{lifeSummary.review.days >= 0 ? '距离计划复查还有 ' + lifeSummary.review.days + ' 天' : '计划日期已过，可以更新复查安排'}}</text><text wx:for="{{lifeSummary.review.checklist}}" wx:key="*this" class="muted">□ {{item}}</text><button class="button button-plain" data-tab="summary" bindtap="openLife">整理复查摘要</button></view>
    <view wx:if="{{lifeSummary.swim_today}}" class="card"><text class="card-title">今日辅助运动 · 游泳</text><text class="muted">本周已记录 {{lifeSummary.swim_week_count}} 次，按个人安排进行。</text><button class="button button-plain" data-tab="swim" bindtap="openLife">记录本次游泳</button></view>
    <view class="overview">
      <view class="metric" bindtap="openBrace" hover-class="tap"><view class="metric-symbol">◷</view><text class="small">今日支具 · {{wearing ? '佩戴中' : '已确认累计'}}</text><text class="metric-value">{{braceError ? '读取失败' : wearText}}</text><text class="small">{{hasBrace ? braceName : '点击管理支具'}} ›</text></view>
      <view class="metric peach" bindtap="openActivity" hover-class="tap"><view class="metric-symbol">✦</view><text class="small">今日训练</text><text class="metric-value">{{planError ? '读取失败' : (deck ? deck.done_count : 0) + ' / ' + cards.length + ' 项'}}</text><text class="small">已记录完成 · 按个人计划进行 ›</text></view>
    </view>
    <view wx:if="{{braceError}}" class="error" bindtap="reload">{{braceError}}</view>
    <view wx:if="{{planError}}" class="error" bindtap="reload">{{planError}}</view>
    <view wx:if="{{profileError}}" class="error" bindtap="reload">{{profileError}}</view>
    <view class="card card-green intro-card"><text class="pill">{{encouragement.label}}</text><text class="card-title">{{encouragement.title}}</text><text class="muted">{{encouragement.encouragement}}</text><button wx:if="{{deck.open_attempt || readyCount}}" class="button" loading="{{starting}}" disabled="{{starting}}" bindtap="startToday">{{deck.open_attempt ? '继续未结束的训练' : '开始今日跟练'}} ›</button><button wx:else class="button" bindtap="openActivity">{{cards.length ? '今日卡组已完成，查看训练' : '整理我的训练卡组'}} ›</button></view>
    <view wx:if="{{deck.open_attempt}}" class="card"><text class="card-title">上次训练还在这里</text><text class="muted">{{deck.open_attempt.card_name}} · {{deck.open_attempt.status === 'paused' ? '已暂停' : '进行中'}}</text><button class="button button-plain" bindtap="startToday" disabled="{{starting}}">恢复本次训练</button></view>
    <view class="section-heading"><text class="section-title">今日动作卡组</text><text class="link" bindtap="openActivity">管理卡组 ›</text></view>
    <text class="small">{{planTitle || '还没有训练计划'}} · 动作安排以本人处方为准</text>
    <view wx:if="{{!cards.length && !planError}}" class="card empty">{{!deck.plan_id ? '先从训练页添加动作，再设置本人处方中的频率。' : !deck.available ? '当前计划暂停或不在计划日期内，暂不安排今日训练。' : deck.rest_count ? '今天可以歇一歇，按自己的计划来。' : '还没有可安排的动作，请先设置频率并核对参数。'}}</view>
    <view wx:if="{{deck.unconfigured_count || deck.needs_setup_count}}" class="card" bindtap="openActivity"><text class="muted">{{deck.unconfigured_count}} 个动作待设置频率，{{deck.needs_setup_count}} 个动作待核对参数。去训练页整理 ›</text></view>
    <view wx:for="{{cards}}" wx:key="id" class="card deck-card {{item.done ? 'deck-done' : ''}}" data-id="{{item.card.id}}" bindtap="openCard" hover-class="tap"><view class="row"><text class="pill">{{item.card.source_category || '个人动作'}}</text><text class="completion-mark">{{item.done ? '✓ 已记录完成' : '○ 待练习'}} ›</text></view><text class="card-title">{{item.card.name}}</text><text class="muted">{{item.dose}}</text><text wx:if="{{item.completed_sets_today}}" class="small">今日已记录 {{item.completed_sets_today}} 组</text></view>
    <view wx:if="{{deck.tomorrow.length}}" class="card"><text class="card-title">明日预览 · {{deck.tomorrow.length}} 项</text><view wx:for="{{deck.tomorrow}}" wx:key="id" class="muted">{{index + 1}}. {{item.name}}</view><text class="small">按当前已保存的记录预览，完成练习后会更新。</text></view>
    <view class="card gentle-note" bindtap="openGrowth" hover-class="tap"><text class="card-title">看看一路走来的变化</text><text class="muted">身高、复查和就诊资料，都留在成长记录里。 ›</text></view>
  </block>
</view>
