<view class="login-wrap">
  <view class="login-card">
    <view class="brand-mark">S</view>
    <text class="login-title">欢迎来到 SPINE</text>
    <text class="login-subtitle">使用微信一键登录，查看你的私人记录</text>
    <view wx:if="{{busy}}" class="checking"><view class="spinner"></view><text>正在登录…</text></view>
    <block wx:else>
      <view wx:if="{{error}}" class="error">{{error}}</view>
      <button class="button login-button" bindtap="retry">重新登录</button>
      <text class="login-footnote">首次登录会为你自动创建账号；记录仅本人可见。</text>
    </block>
  </view>
</view>
