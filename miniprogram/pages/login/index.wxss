.login-wrap { min-height: 100vh; display: flex; flex-direction: column; gap: 24rpx; align-items: center; justify-content: center; padding: 36rpx; }
.login-card { width: 100%; max-width: 640rpx; padding: 42rpx 34rpx; border-radius: 28rpx; background: #fff; }
.brand-mark { width: 84rpx; height: 84rpx; margin: 0 auto 18rpx; border-radius: 50%; background: #eaf3ed; color: #246b57; font-size: 50rpx; line-height: 84rpx; text-align: center; }
.login-title, .login-subtitle { display: block; text-align: center; }
.login-title { font-size: 40rpx; font-weight: 650; }
.login-subtitle { margin: 14rpx 0 30rpx; color: #718078; }
.login-button { margin-top: 28rpx; }
.login-footnote { display: block; margin-top: 20rpx; color: #87928c; font-size: 22rpx; text-align: center; }
.checking { display: flex; justify-content: center; align-items: center; gap: 16rpx; min-height: 180rpx; color: #718078; }
.spinner { width: 30rpx; height: 30rpx; border: 4rpx solid #dbe8df; border-top-color: #246b57; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
