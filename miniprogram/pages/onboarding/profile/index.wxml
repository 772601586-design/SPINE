<view class="page">
  <view class="heading">
    <text class="eyebrow">{{stepIndex + 1}} / 4 · 你好，我是小树</text>
    <text class="title">{{stage === 'xray' ? '保存已有资料' : steps[stepIndex]}}</text>
    <text class="subtitle">{{stage === 'ready' ? '先从一件小事开始，我们陪你慢慢来。' : '不用一次填完，按自己的节奏来。'}}</text>
    <view class="step-track"><view wx:for="{{steps}}" wx:key="*this" class="step-dot {{index <= stepIndex ? 'step-done' : ''}}"></view></view>
  </view>

  <block wx:if="{{loading}}"><view class="card"><view class="empty">正在准备你的档案…</view></view></block>

  <block wx:elif="{{blocking}}">
    <view class="error" bindtap="retryLoad">{{blocking}} 点击重试</view>
    <button class="button button-plain" bindtap="retryLoad">重试</button>
  </block>

  <block wx:elif="{{ready}}">
    <view class="error" wx:if="{{error}}">{{error}}</view>

    <block wx:if="{{stage === 'profile'}}">

    <view class="card">
      <text class="card-title">昵称</text>
      <view class="field {{fieldErrors.nickname ? 'field-invalid' : ''}}">
        <input class="input" value="{{nickname}}" maxlength="50" placeholder="给自己起个名字"
          placeholder-class="placeholder" bindinput="onNickname" />
      </view>
      <text class="small">昵称会显示在社区等内容里，手机号、微信标识不会对外展示。</text>
    </view>

    <view class="card">
      <text class="card-title">出生年月（可跳过）</text>
      <picker mode="date" fields="month" value="{{birthMonth}}" start="1900-01" end="{{todayMonth}}" bindchange="onBirthMonth"><view class="field picker-field"><text>{{birthMonth || '选择出生年月'}}</text><text class="arrow">›</text></view></picker>
      <text wx:if="{{birthMonth}}" class="link" bindtap="clearBirthMonth">暂不填写</text>
      <text class="label">性别（可跳过）</text>
      <view wx:for="{{genders}}" wx:key="value" class="pill {{gender === item.value ? 'pill-active' : ''}}" data-value="{{item.value}}" bindtap="chooseGender">{{item.label}}</view>
      <view wx:if="{{gender === 'custom'}}" class="field"><input value="{{genderCustom}}" maxlength="50" placeholder="填写你的称呼" bindinput="onGenderCustom" /></view>
    </view>
      <button class="button" bindtap="nextStep">下一步 · 选择阶段</button>
      <text class="small center">这些资料仅本人可见，可以随时修改。</text>
    </block>

    <block wx:elif="{{stage === 'treatment'}}">
      <text class="muted">你现在处于哪个阶段？只用于整理页面提示，不会替你调整处方。</text>
      <view wx:for="{{treatments}}" wx:key="value" class="card stage-option {{treatment === item.value ? 'stage-selected' : ''}}" data-value="{{item.value}}" bindtap="chooseTreatment" hover-class="tap"><view class="row"><text class="list-title">{{item.label}}</text><text class="stage-mark">{{treatment === item.value ? '✓' : '○'}}</text></view><text class="muted">{{item.desc}}</text></view>
      <button class="button" bindtap="nextStep">下一步 · 补充资料</button>
      <button class="button button-plain" bindtap="previousStep">上一步</button>
    </block>

    <block wx:elif="{{stage === 'basics'}}">
    <view wx:if="{{gender === 'female' || gender === 'custom'}}" class="card"><text class="card-title">初潮情况（可跳过）</text><text class="muted">如适用且愿意记录，可以在这里填写。</text><view><view wx:for="{{menarcheOptions}}" wx:key="value" class="pill {{menarche === item.value ? 'pill-active' : ''}}" data-value="{{item.value}}" bindtap="chooseMenarche">{{item.label}}</view></view></view>

    <view class="card">
      <view class="row" bindtap="toggleExtra">
        <text class="card-title tight">补充信息（可跳过）</text>
        <text class="arrow">{{hasExtra ? '收起' : '展开'}}</text>
      </view>
      <text class="muted">不填不影响使用，随时可以在「我的 → 我的档案」里补上。</text>

      <block wx:if="{{hasExtra}}">
        <view class="divider"></view>

        <text class="label">诊断状态</text>
        <picker mode="selector" range="{{diagnosisLabels}}" value="{{diagnosisIndex}}" bindchange="onDiagnosis">
          <view class="field picker-field">
            <text>{{diagnosisLabels[diagnosisIndex]}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>

        <text class="label">管理方式（可多选）</text>
        <view>
          <view wx:for="{{methods}}" wx:key="value" class="pill {{item.checked ? 'pill-active' : ''}}"
            data-index="{{index}}" bindtap="toggleMethod">{{item.label}}</view>
        </view>

        <text class="label">备注</text>
        <view class="field">
          <textarea class="textarea" value="{{notes}}" maxlength="500" placeholder="想记下的背景信息（可留空）"
            placeholder-class="placeholder" bindinput="onNotes" />
        </view>
      </block>
    </view>

      <button class="button" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">保存资料并继续</button>
      <button class="button button-plain" disabled="{{saving}}" bindtap="previousStep">上一步</button>
      <text class="small center">这些内容仅本人可见，不会用于任何公开推荐。</text>
    </block>

    <block wx:elif="{{stage === 'xray'}}">
      <view class="card card-green">
        <text class="card-title">请上传已有的 X 光影像</text>
        <text class="muted">影像照片或包含影像的 PDF 均可。报告请在就诊资料中另行保存。只上传你已有的资料，不需要为了完成注册新做检查。</text>
        <text class="small">原件默认仅本人可见。系统只检查文件格式、是否可读取和安全状态，不判断影像质量或医学内容。</text>
      </view>
      <view class="card">
        <view class="row gap">
          <button class="button button-plain compact" bindtap="chooseXrayImage">从相册选择影像</button>
          <button class="button button-plain compact" bindtap="chooseXrayPdf">选择 PDF</button>
        </view>
        <view wx:if="{{xrayFile}}" class="list-item">
          <text class="list-title">{{xrayFile.name}}</text>
          <text class="small">已选择，上传前请确认内容</text>
          <image wx:if="{{xrayIsImage}}" class="xray-preview" src="{{xrayFile.path}}" mode="widthFix" bindtap="previewXray" />
        </view>
        <text class="label">影像日期</text>
        <view class="row gap">
          <view class="pill {{xrayDatePrecision === 'unknown' ? 'pill-active' : ''}}" data-value="unknown" bindtap="chooseXrayDatePrecision">不详</view>
          <view class="pill {{xrayDatePrecision === 'day' ? 'pill-active' : ''}}" data-value="day" bindtap="chooseXrayDatePrecision">精确到日</view>
          <view class="pill {{xrayDatePrecision === 'month' ? 'pill-active' : ''}}" data-value="month" bindtap="chooseXrayDatePrecision">精确到月</view>
        </view>
        <picker wx:if="{{xrayDatePrecision === 'day'}}" mode="date" value="{{xrayDate}}" end="{{todayDate}}" bindchange="onXrayDate">
          <view class="field picker-field"><text>{{xrayDate}}</text><text class="arrow">›</text></view>
        </picker>
        <picker wx:if="{{xrayDatePrecision === 'month'}}" mode="date" fields="month" value="{{xrayDate}}" end="{{todayMonth}}" bindchange="onXrayDate">
          <view class="field picker-field"><text>{{xrayDate}}</text><text class="arrow">›</text></view>
        </picker>
        <checkbox-group bindchange="onXrayConfirmed">
          <label class="confirm-row"><checkbox value="confirmed" checked="{{xrayConfirmed}}" />这是本人已有的 X 光影像，我已检查文件可以查看</label>
        </checkbox-group>
      </view>
      <button class="button" loading="{{uploadingXray}}" disabled="{{uploadingXray || !xrayFile}}" bindtap="uploadXray">确认并安全上传，完成建档</button>
      <button class="button button-plain" disabled="{{uploadingXray}}" bindtap="saveForLater">已有资料以后再补，先开始</button>
      <text class="small center">缺少影像时档案保持草稿；你仍可浏览和记录。完成建档不代表诊断或专业审核。</text>
    </block>

    <block wx:elif="{{stage === 'ready'}}">
      <view class="welcome-symbol">✓</view>
      <view class="card card-green"><text class="card-title">{{encouragement.title}}</text><text class="muted">{{encouragement.encouragement}}</text></view>
      <view class="card"><view class="row"><text class="small">当前阶段</text><text>{{encouragement.label}}</text></view><view class="divider"></view><text class="muted">可以在「训练」里整理自己的动作，在「成长」里保存测量和复查记录。阶段随时可在「我的」里切换。</text></view>
      <button class="button" bindtap="enterApp">准备好了，进入今日</button>
    </block>
  </block>
</view>
