.tight { margin-bottom: 0; }
.label { display: block; margin: 22rpx 0 10rpx; color: #648074; font-size: 23rpx; }
.input { width: 100%; height: 44rpx; font-size: 30rpx; }
.textarea { width: 100%; height: 150rpx; font-size: 28rpx; }
.placeholder { color: #a9b4ae; }
.picker-field { display: flex; align-items: center; justify-content: space-between; margin: 0; }
.arrow { color: #87928c; font-size: 24rpx; }
.link { display: block; margin-top: 10rpx; color: #246b57; font-size: 23rpx; }
.field-invalid { border-color: #e0a294; background: #fff8f6; }
.center { display: block; margin-top: 16rpx; text-align: center; }
.confirm-row { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; color: #24382e; font-size: 27rpx; line-height: 1.5; }
.xray-preview { width: 100%; max-height: 560rpx; margin-top: 16rpx; border-radius: 16rpx; background: #f6f8f2; }
