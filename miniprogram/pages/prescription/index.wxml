<view class="page"><view class="heading"><text class="title">整理个人处方</text><text class="subtitle">按原处方逐项转录，先看变更再保存。参数保存后需到动作卡再次核对才能跟练。</text></view>
  <view class="card"><text class="card-title">从印刷处方图片识别</text><text class="muted">使用服务端本机 OCR，不上传到第三方。识别可能有误，请逐项对照原件；未识别出的字段需要手动补全。</text><button class="button button-plain" loading="{{recognizing}}" disabled="{{recognizing || busy || saved}}" bindtap="choosePrescription">选择处方图片并识别</button><textarea wx:if="{{ocrText}}" class="field" maxlength="20000" value="{{ocrText}}" bindinput="inputOCR" placeholder="识别原文，可校对" /></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card empty">读取现有处方…</view>
  <view wx:elif="{{saved}}" class="card card-green"><text class="card-title">处方已保存，历史执行记录仍然保留</text><button class="button" bindtap="openTraining">查看并核对动作卡</button></view>
  <block wx:else><picker wx:if="{{cards.length}}" range="{{cards}}" range-key="name" bindchange="loadCard"><view class="card">选择已有动作，整理本次变更 ›</view></picker>
    <view wx:for="{{rows}}" wx:key="index" class="card" wx:for-index="rowIndex"><text class="card-title">{{item.card_id ? '更新已有动作' : '新增动作'}} {{rowIndex + 1}}</text><input class="field" value="{{item.name}}" data-index="{{rowIndex}}" data-field="name" bindinput="input" placeholder="处方动作名称 / 本人显示名称" /><view class="dose-grid"><input class="field" type="number" value="{{item.sets}}" data-index="{{rowIndex}}" data-field="sets" bindinput="input" placeholder="组数" /><input class="field" type="number" value="{{item.reps_per_set}}" data-index="{{rowIndex}}" data-field="reps_per_set" bindinput="input" placeholder="每组次数" /><input class="field" type="number" value="{{item.breaths_per_set}}" data-index="{{rowIndex}}" data-field="breaths_per_set" bindinput="input" placeholder="每组呼吸数" /><input class="field" type="number" value="{{item.hold_seconds}}" data-index="{{rowIndex}}" data-field="hold_seconds" bindinput="input" placeholder="保持秒数" /></view><picker range="{{sides}}" range-key="label" data-index="{{rowIndex}}" data-field="side" bindchange="choose"><view class="field">方向：{{item.side || '待核对'}} ›</view></picker><picker range="{{frequencies}}" range-key="label" data-index="{{rowIndex}}" data-field="schedule_frequency" bindchange="choose"><view class="field">频率：{{item.schedule_frequency === 'daily' ? '每天' : item.schedule_frequency === 'alternate' ? '隔天' : '暂不排入今日'}} ›</view></picker><textarea class="field" maxlength="3000" value="{{item.personal_notes}}" data-index="{{rowIndex}}" data-field="personal_notes" bindinput="input" placeholder="标准名称、别名及康复师提醒（原话）" /><button class="button button-plain" data-index="{{rowIndex}}" bindtap="removeRow">移除这一行</button></view>
    <button class="button button-plain" bindtap="addRow">＋ 添加动作</button><button class="button" bindtap="showPreview">查看本次变更</button><view wx:if="{{preview}}" class="card"><text class="card-title">核对变更</text><view wx:for="{{changes}}" wx:key="index" class="change"><text>{{item.name}}</text><text class="muted">原：{{item.before}}</text><text class="muted">新：{{item.after}}</text></view><button class="button" disabled="{{busy}}" loading="{{busy}}" bindtap="save">确认转录内容并保存</button></view>
  </block>
</view>
