{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitThis": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2017"],
    "types": []
  },
  "include": ["**/*.ts", "typings/**/*.d.ts"],
  "exclude": ["node_modules"]
}
